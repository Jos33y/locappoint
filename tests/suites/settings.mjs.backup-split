export default async ({ browser, url, check }) => {
    const wait = (ms = 250) => new Promise((r) => setTimeout(r, ms))
    const open = async (path, vw = 1272, vh = 800, touch = false) => {
      const page = await browser.newPage()
      page.errors = []
      page.on('pageerror', (e) => page.errors.push(e.message))
      await page.setViewport({ width: vw, height: vh, hasTouch: touch, isMobile: touch })
      await page.goto(`${url}/?path=${encodeURIComponent(path)}`, { waitUntil: 'networkidle0' })
      await wait(400)
      return page
    }
    const calls = (p, kind, table) => p.evaluate((kind, table) => window.__calls.filter((c) => c[0] === kind && (!table || c[1] === table)).map((c) => c[table ? 2 : 1]), kind, table)
    const text = (p, sel) => p.evaluate((sel) => document.querySelector(sel)?.textContent.trim(), sel)
    const clickText = (p, sel, t) => p.evaluate((sel, t) => { const el = [...document.querySelectorAll(sel)].find((e) => e.textContent.trim().startsWith(t)); if (el) el.click(); return Boolean(el) }, sel, t)
    const selectAll = async (p) => { await p.keyboard.down('Control'); await p.keyboard.press('a'); await p.keyboard.up('Control') }

    let p = await open('/portal/settings')
    await wait(1000)
    check((await calls(p, 'update', 'users')).length === 0, 'no save on open')
    check(!(await p.evaluate(() => document.body.textContent.includes('Invalid Date'))), 'no invalid date')
    check(await p.evaluate(() => document.querySelector('.biz-st__since')?.textContent) === 'Member since March 2026', 'member since in the identity card')
    check(await p.evaluate(() => !document.querySelector('.biz-page__head .biz-save') && Boolean(document.querySelector('.biz-st__namefield .biz-save'))), 'save state sits with the name field')
    check(!(await p.evaluate(() => [...document.querySelectorAll('.biz-st [role=switch]')].length)), 'no unwired notification switches')
    check(await p.evaluate(() => document.body.textContent.includes('Booking alerts') && Boolean(document.querySelector('#alerts-title').closest('section').querySelector('.biz-soon'))), 'alerts marked Soon')
    check(await p.evaluate(() => document.querySelector('.biz-account__btn').classList.contains('is-current')), 'account row current on settings')
    const name = await p.$('.biz-st__namefield input')
    await name.focus(); await selectAll(p); await p.keyboard.press('Backspace')
    await wait(1000)
    check(await text(p, '.biz-save') === 'Enter your name to save it', 'empty name blocked')
    check((await calls(p, 'update', 'users')).length === 0, 'empty name not saved')
    await p.keyboard.type('Miles F. Farra')
    await wait(1100)
    check((await calls(p, 'update', 'users')).slice(-1)[0]?.full_name === 'Miles F. Farra', 'name saved')
    check(await text(p, '.biz-st__idname') === 'Miles F. Farra', 'identity card follows the name')
    check(await text(p, '.biz-save') === 'All changes saved', 'saved state')
    check(await p.evaluate(() => window.__refreshed > 0), 'profile refreshed')

    await clickText(p, '.biz-st button', 'Change password')
    await wait(400)
    await clickText(p, '.ui-sheet button', 'Change password')
    await wait(300)
    check(await p.evaluate(() => document.body.textContent.includes('Enter the password you use today') && document.body.textContent.includes('Use at least 8 characters')), 'password errors after trying')
    check((await calls(p, 'signIn')).length === 0, 'no sign in attempt while invalid')
    const inputs = await p.$$('.ui-sheet .biz-st__pw input')
    await inputs[0].type('wrong-password'); await inputs[1].type('new-secret-1'); await inputs[2].type('new-secret-1')
    await clickText(p, '.ui-sheet button', 'Change password')
    await wait(500)
    check(await p.evaluate(() => document.body.textContent.includes('That is not your current password.')), 'wrong current password')
    check((await calls(p, 'updateUser')).length === 0, 'password not changed on wrong current')
    await inputs[0].focus(); await selectAll(p); await p.keyboard.type('right-password')
    await clickText(p, '.ui-sheet button', 'Change password')
    await wait(600)
    check((await calls(p, 'updateUser')).slice(-1)[0]?.password === 'new-secret-1', 'password changed')
    check(await p.evaluate(() => !document.querySelector('.biz-st__pw')), 'sheet closed')
    check(await p.evaluate(() => document.querySelector('.biz-toast')?.textContent.includes('Password changed')), 'toast')

    await clickText(p, '.biz-st button', 'Sign out everywhere')
    await wait(400)
    check(await p.evaluate(() => document.body.textContent.includes('You will be signed out on every phone')), 'sign out sheet explains')
    await clickText(p, '.ui-sheet button', 'Sign out everywhere')
    await wait(400)
    check((await calls(p, 'signOut')).slice(-1)[0]?.scope === 'global', 'global sign out')
    check(await p.evaluate(() => document.querySelector('a[href^="mailto:support@locappoint.com?subject=Close"]') !== null), 'close account goes to support')
    check(p.errors.length === 0, `errors ${p.errors}`)
    await p.close()

    p = await open('/portal/settings', 390, 844, true)
    const fits = await p.evaluate(() => ({ doc: document.documentElement.scrollWidth, vw: innerWidth, input: document.querySelector('.biz-st__namefield input').getBoundingClientRect().width, card: document.querySelector('.biz-st__card').getBoundingClientRect().width, small: [...document.querySelectorAll('.biz-st button, .biz-st a.ui-btn')].filter((b) => b.getBoundingClientRect().height > 0 && b.getBoundingClientRect().height < 44).map((b) => b.textContent) }))
    check(fits.doc <= fits.vw, 'no overflow on phone')
    check(fits.input > fits.card - 60, `name field fills the card ${JSON.stringify(fits)}`)
    check(fits.small.length === 0, `touch targets ${fits.small}`)
    await p.close()
}
