export default async ({ browser, url, check, only }) => {
    const SCREENS = [
      ['phone-320', 320, 568, true], ['phone-360', 360, 740, true], ['phone-390', 390, 844, true],
      ['tab-768', 768, 1024, true], ['tab-820', 820, 1180, true], ['tab-1024', 1024, 768, true], ['tab-1180', 1180, 820, true], ['tab-1366', 1366, 1024, true],
      ['lap-1272x588', 1272, 588, false], ['lap-1280x720', 1280, 720, false], ['lap-1280x800', 1280, 800, false], ['lap-1440x900', 1440, 900, false], ['lap-1920x1080', 1920, 1080, false],
    ]
    const PAGES = ['/portal', '/portal/calendar', '/portal/page', '/portal/services', '/portal/hours', '/portal/team', '/portal/channels', '/portal/insights', '/portal/reviews', '/portal/invite', '/portal/settings', '/portal/help', '/portal/start']
    for (const [name, w, h, touch] of SCREENS) {
      if (only && !name.includes(only)) continue
      const page = await browser.newPage()
      const errors = []
      page.on('pageerror', (e) => errors.push(e.message))
      await page.setViewport({ width: w, height: h, deviceScaleFactor: 1, hasTouch: touch, isMobile: touch && w < 1024 })
      for (const path of PAGES) {
        await page.goto(`${url}/?path=${encodeURIComponent(path)}`, { waitUntil: 'networkidle0' })
        await new Promise((r) => setTimeout(r, 250))
        const tag = `${name} ${path}`
        const r = await page.evaluate(() => {
          const q = (s) => document.querySelector(s)
          const box = (el) => el && el.getBoundingClientRect()
          const side = q('.biz-sidebar')
          const sideOn = side && getComputedStyle(side).display !== 'none'
          const nav = q('.biz-sidebar__nav')
          const rows = [...document.querySelectorAll('.biz-sidebar .biz-navlink, .biz-account__btn')].map((el) => ({ t: el.textContent.trim(), b: el.getBoundingClientRect().bottom, top: el.getBoundingClientRect().top, h: el.getBoundingClientRect().height }))
          const hub = q('.biz-hubnav__track')
          const tabs = [...document.querySelectorAll('.biz-hubnav__tab')].map((el) => { const l = el.querySelector('.biz-hubnav__label'); const b = el.getBoundingClientRect(); return { t: l.textContent, trunc: l.scrollWidth > l.clientWidth + 0.5, h: b.height, r: b.right, l: b.left, active: el.classList.contains('active') } })
          const activeRows = [...document.querySelectorAll('.biz-sidebar .biz-navlink.active')].map((el) => el.textContent.trim())
          return {
            vw: innerWidth, vh: innerHeight, docW: document.documentElement.scrollWidth,
            sideOn, navScroll: nav ? nav.scrollHeight - nav.clientHeight : 0, rows,
            hub: hub && { l: box(hub).left, r: box(hub).right, w: box(hub).width },
            tabs, activeRows, path: window.__path,
            acctCurrent: q('.biz-account__btn')?.classList.contains('is-current'),
            bp: q('.biz-bp') && {
              wide: q('.biz-bp').classList.contains('is-wide'),
              phone: q('.biz-bp__preview .ui-phone') && (() => { const b = q('.biz-bp__preview .ui-phone').getBoundingClientRect(); return { top: b.top, bottom: b.bottom, w: b.width } })(),
              cards: [...document.querySelectorAll('.biz-bp__card, .biz-bp__link')].filter((c) => c.scrollWidth > c.clientWidth + 1).map((c) => c.id || c.className),
              small: [...document.querySelectorAll('.biz-bp button, .biz-bp a.ui-btn, .biz-bp [role=switch]')].filter((b) => !b.closest('.lc-pub--preview') && !b.closest('.ui-sheet')).filter((b) => { const h = (b.getAttribute('role') === 'switch' ? b.closest('.ui-switchrow') : b).getBoundingClientRect().height; return h > 0 && h < 44 }).map((b) => `${b.textContent.trim() || b.getAttribute('aria-label') || b.className} ${Math.round(b.getBoundingClientRect().height)}`),
              url: (() => { const u = q('.biz-bp__url'); const card = q('.biz-bp__link'); return u.getBoundingClientRect().right <= card.getBoundingClientRect().right })(),
            },
          }
        })
        check(r.docW <= r.vw, `${tag} horizontal overflow ${r.docW} > ${r.vw}`)
        const inHub = ['/portal/page', '/portal/services', '/portal/hours', '/portal/team', '/portal/channels', '/portal/insights', '/portal/reviews', '/portal/invite'].includes(path)
        check(Boolean(r.hub) === inHub, `${tag} hub nav presence ${Boolean(r.hub)}`)
        if (r.hub) {
          check(r.hub.l >= 0 && r.hub.r <= r.vw, `${tag} hub track off screen ${r.hub.l}-${r.hub.r}`)
          for (const t of r.tabs) {
            check(!t.trunc, `${tag} tab label truncated ${t.t}`)
            check(t.r <= r.hub.r + 0.5 && t.l >= r.hub.l - 0.5, `${tag} tab outside track ${t.t}`)
            if (touch) check(t.h >= 44, `${tag} touch tab ${t.t} ${t.h}px`)
          }
          check(r.tabs.filter((t) => t.active).length === 1, `${tag} one active tab`)
        }
        if (r.bp) {
          check(r.bp.cards.length === 0, `${tag} card overflow ${r.bp.cards}`)
          check(r.bp.url, `${tag} link spills out of its card`)
          if (touch) check(r.bp.small.length === 0, `${tag} small touch targets ${r.bp.small}`)
          if (r.bp.phone) check(r.bp.phone.top >= 0 && r.bp.phone.bottom <= r.vh, `${tag} preview phone clipped ${JSON.stringify(r.bp.phone)}`)
          if (w >= 1272) check(r.bp.wide, `${tag} expected the rail beside the form`)
        }
        if (w >= 1024) {
          check(r.sideOn, `${tag} sidebar shown`)
          check(r.navScroll <= 0, `${tag} nav scrolls by ${r.navScroll}px`)
          for (const row of r.rows) check(row.b <= r.vh && row.top >= 0, `${tag} row off screen ${row.t} ${row.b}`)
          const labels = r.rows.map((x) => x.t)
          for (const need of ['Today', 'Calendar', 'Your business', 'Grow']) check(labels.some((x) => x.startsWith(need)), `${tag} missing ${need}`)
          const expectHub = path in { '/portal/page': 1, '/portal/services': 1, '/portal/hours': 1, '/portal/team': 1 } ? 'Your business' : ['/portal/channels', '/portal/insights', '/portal/reviews', '/portal/invite'].includes(path) ? 'Grow' : null
          if (expectHub) check(r.activeRows.includes(expectHub) && r.activeRows.length === 1, `${tag} active rows ${r.activeRows}`)
          if (path === '/portal') check(r.activeRows.join() === 'Today', `${tag} active rows ${r.activeRows}`)
          check(r.acctCurrent === ['/portal/settings', '/portal/help'].includes(path), `${tag} account current ${r.acctCurrent}`)
        } else {
          check(!r.sideOn, `${tag} sidebar hidden`)
        }
      }
      if (w >= 1024) {
        await page.goto(`${url}/?path=/portal/services`, { waitUntil: 'networkidle0' })
        await page.click('.biz-account__btn')
        await new Promise((r) => setTimeout(r, 250))
        const m = await page.evaluate(() => {
          const menu = document.querySelector('.biz-acctmenu').getBoundingClientRect()
          const btn = document.querySelector('.biz-account__btn').getBoundingClientRect()
          const items = [...document.querySelectorAll('.biz-acctmenu [role=menuitem]')].map((el) => el.textContent.trim())
          return { top: menu.top, bottom: menu.bottom, left: menu.left, right: menu.right, btnTop: btn.top, items, focus: document.activeElement.textContent.trim(), vh: innerHeight }
        })
        check(m.top >= 0 && m.bottom <= m.btnTop, `${name} menu placement ${JSON.stringify(m)}`)
        check(m.items.join('|') === 'Settings|Help and support|Replay the tour|Switch to Booking|Sign out', `${name} menu items ${m.items}`)
        check(m.focus === 'Settings', `${name} menu first focus ${m.focus}`)
      }
      check(errors.length === 0, `${name} page errors ${errors}`)
      await page.close()
    }
}
