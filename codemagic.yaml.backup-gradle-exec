# Codemagic builds the phone apps from this repo. Nothing here runs on its own: start a build in Codemagic.
#
# Set up once in Codemagic (Team settings):
#   Code signing identities > Android keystores: upload the upload keystore, reference name "locappoint_upload"
#   Environment variables, group "locappoint_web": VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY, VITE_PUBLIC_URL=https://locappoint.com
#   Environment variables, group "supabase_upload": SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY (secret)
#   Integrations > Developer Portal: App Store Connect API key named "locappoint" (once the Apple account exists)

workflows:
  android:
    name: Android (APK for the website, AAB for Google Play)
    max_build_duration: 60
    instance_type: mac_mini_m2
    environment:
      node: 22
      java: 21
      android_signing:
        - locappoint_upload
      groups:
        - locappoint_web
        - supabase_upload
    scripts:
      - name: Android SDK location
        script: echo "sdk.dir=$ANDROID_SDK_ROOT" > "$CM_BUILD_DIR/android/local.properties"
      - name: Install
        script: npm ci
      - name: Build the web app
        script: npm run build
      - name: Copy it into the Android project
        script: npx cap sync android
      - name: Build signed APK and AAB
        script: |
          cd android
          ./gradlew assembleRelease bundleRelease -PversionCode=$BUILD_NUMBER -PversionName=1.0.$BUILD_NUMBER
      - name: Publish the APK to locappoint.com/app
        script: |
          VERSION="1.0.$BUILD_NUMBER"
          FILE="locappoint-$VERSION.apk"
          APK="android/app/build/outputs/apk/release/app-release.apk"
          SIZE=$(wc -c < "$APK" | tr -d ' ')
          curl --fail -sS -X POST "$SUPABASE_URL/storage/v1/object/downloads/$FILE" \
            -H "apikey: $SUPABASE_SERVICE_ROLE_KEY" -H "Authorization: Bearer $SUPABASE_SERVICE_ROLE_KEY" \
            -H "Content-Type: application/vnd.android.package-archive" -H "x-upsert: true" \
            --data-binary @"$APK"
          printf '{"version":"%s","file":"%s","size":%s}' "$VERSION" "$FILE" "$SIZE" > latest.json
          curl --fail -sS -X POST "$SUPABASE_URL/storage/v1/object/downloads/latest.json" \
            -H "apikey: $SUPABASE_SERVICE_ROLE_KEY" -H "Authorization: Bearer $SUPABASE_SERVICE_ROLE_KEY" \
            -H "Content-Type: application/json" -H "x-upsert: true" -H "cache-control: max-age=60" \
            --data-binary @latest.json
    artifacts:
      - android/app/build/outputs/apk/release/*.apk
      - android/app/build/outputs/bundle/release/*.aab

  ios:
    name: iPhone (TestFlight)
    max_build_duration: 60
    instance_type: mac_mini_m2
    integrations:
      app_store_connect: locappoint
    environment:
      node: 22
      xcode: latest
      ios_signing:
        distribution_type: app_store
        bundle_identifier: com.locappoint.app
      groups:
        - locappoint_web
    scripts:
      - name: Install
        script: npm ci
      - name: Build the web app
        script: npm run build
      - name: Copy it into the iPhone project
        script: npx cap sync ios
      - name: Signing profiles
        script: xcode-project use-profiles
      - name: Build number
        script: sed -i '' "s/CURRENT_PROJECT_VERSION = [0-9]*;/CURRENT_PROJECT_VERSION = $BUILD_NUMBER;/g" ios/App/App.xcodeproj/project.pbxproj
      - name: Build the app file
        script: xcode-project build-ipa --project "ios/App/App.xcodeproj" --scheme "App"
    artifacts:
      - build/ios/ipa/*.ipa
      - /tmp/xcodebuild_logs/*.log
    publishing:
      app_store_connect:
        auth: integration
        submit_to_testflight: true
