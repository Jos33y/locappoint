{
  "appId": "com.locappoint.app",
  "appName": "Locappoint",
  "webDir": "dist",
  "backgroundColor": "#10141D",
  "appendUserAgent": "LocappointApp/dev",
  "ios": {
    "contentInset": "always"
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "native",
      "style": "DARK"
    },
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#10141D",
      "showSpinner": false
    }
  }
}
