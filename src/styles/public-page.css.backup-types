.lc-pub {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    width: 100%;
    padding-bottom: var(--space-8);
    color: var(--lc-ink-1);
    font-family: var(--lc-font-body);
}

.lc-pub__cover {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--lc-panel);
}

.lc-pub__cover img,
.lc-pub__cover svg {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
}

.lc-pub__cover::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background: var(--lc-line);
}

.lc-pub__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    margin-top: calc(var(--space-8) * -1 - 44px);
    padding: 0 var(--space-5);
}

.lc-pub__logo {
    position: relative;
    display: grid;
    place-items: center;
    width: 88px;
    height: 88px;
    overflow: hidden;
    margin-bottom: var(--space-1);
    border-radius: var(--lc-r-xl);
    background: var(--azure);
    box-shadow: 0 0 0 4px var(--lc-canvas), var(--lc-shadow-raised);
    color: var(--lc-on-accent);
    font-family: var(--lc-font-display);
    font-size: 30px;
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.01em;
}

.lc-pub__logo img {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
}

.lc-pub__name {
    margin: 0;
    font-family: var(--lc-font-display);
    font-size: clamp(1.625rem, 6cqi, 2.5rem);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--lc-track-title);
    line-height: var(--lc-lh-tight);
    overflow-wrap: anywhere;
}

.lc-pub__where {
    margin: calc(var(--space-2) * -1) 0 0;
    color: var(--lc-ink-3);
    font-size: var(--lc-t-body);
}

.lc-pub__status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    color: var(--lc-ink-2);
    font-size: var(--lc-t-label);
}

.lc-pub__about {
    max-width: 60ch;
    margin: 0;
    color: var(--lc-ink-2);
    font-size: var(--lc-t-body);
    line-height: var(--lc-lh-body);
    white-space: pre-line;
}

.lc-pub__actions {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2);
    width: 100%;
    margin-top: var(--space-1);
}

.lc-pub__actions .ui-btn {
    min-width: 0;
    min-height: 64px;
    padding: var(--space-2) var(--space-1);
    border-radius: var(--lc-r-lg);
    font-size: var(--lc-t-label);
}

.lc-pub__actions .ui-btn__content {
    flex-direction: column;
    gap: 6px;
}

.lc-pub__section {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: 0 var(--space-5);
}

.lc-pub__h2 {
    margin: 0;
    font-family: var(--lc-font-display);
    font-size: var(--lc-t-heading);
    font-weight: var(--font-weight-semibold);
}

.lc-pub__empty {
    margin: 0;
    padding: var(--space-6) var(--space-4);
    border-radius: var(--lc-r-lg);
    background: var(--lc-card);
    box-shadow: inset 0 0 0 1px var(--lc-line);
    color: var(--lc-ink-3);
    font-size: var(--lc-t-label);
    text-align: center;
}

.lc-pub__services {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
}

.lc-pub__service {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4);
    border-radius: var(--lc-r-lg);
    background: var(--lc-raised);
    box-shadow: var(--lc-shadow-raised);
    animation: lc-pub-in var(--lc-base) var(--lc-ease);
}

@keyframes lc-pub-in {
    from { opacity: 0; transform: translateY(6px); }
}

.lc-pub__svcmain {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
}

.lc-pub__svcname {
    font-size: var(--lc-t-body);
    font-weight: var(--font-weight-semibold);
    overflow-wrap: anywhere;
}

.lc-pub__svcmeta {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--lc-ink-3);
    font-size: var(--lc-t-label);
}

.lc-pub__svcdesc {
    margin-top: 2px;
    color: var(--lc-ink-3);
    font-size: var(--lc-t-label);
    line-height: var(--lc-lh-snug);
}

.lc-pub__svcside {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-2);
    flex: none;
}

.lc-pub__price {
    font-family: var(--lc-font-mono);
    font-size: var(--lc-t-body);
    font-variant-numeric: tabular-nums;
}

.lc-pub__hours {
    margin: 0;
    border-radius: var(--lc-r-lg);
    background: var(--lc-card);
    box-shadow: inset 0 0 0 1px var(--lc-line);
}

.lc-pub__hoursrow {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    font-size: var(--lc-t-label);
}

.lc-pub__hoursrow + .lc-pub__hoursrow {
    border-top: 1px solid var(--lc-line);
}

.lc-pub__hoursrow dt {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--lc-ink-2);
}

.lc-pub__hoursrow dd {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
    margin: 0;
    color: var(--lc-ink-1);
    font-family: var(--lc-font-mono);
    font-variant-numeric: tabular-nums;
    text-align: right;
}

.lc-pub__hoursrow dd span { white-space: nowrap; }

.lc-pub__hoursrow.is-today dt {
    color: var(--lc-ink-1);
    font-weight: var(--font-weight-semibold);
}

.lc-pub__today {
    padding: 1px 8px;
    border-radius: var(--radius-full);
    background: var(--lc-info-tint);
    color: var(--lc-info);
    font-size: var(--lc-t-micro);
    font-weight: var(--font-weight-semibold);
}

.lc-pub__address {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    margin: 0;
    color: var(--lc-ink-2);
    font-size: var(--lc-t-label);
}

.lc-pub__address svg {
    flex: none;
    margin-top: 2px;
}

.lc-pub__foot {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-5) 0;
    color: var(--lc-ink-3);
    font-size: var(--lc-t-label);
}

.lc-pub .lc-mark {
    display: block;
    flex: none;
}

.lc-pub .lc-wordmark {
    color: var(--lc-ink-2);
    font-family: var(--lc-font-display);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-tight);
}

.lc-pub .lc-wordmark__accent { color: var(--azure); }

.lc-pub--preview {
    gap: var(--space-6);
    padding-bottom: var(--space-6);
}

@container (max-width: 320px) {
    .lc-pub__actions .ui-btn {
        min-height: 56px;
        overflow: hidden;
        font-size: var(--lc-t-micro);
    }

    .lc-pub__actions .ui-btn__content { gap: 4px; }

    .lc-pub__hoursrow {
        padding: var(--space-3);
        font-size: 12px;
    }
}

@container (max-width: 240px) {
    .lc-pub__actions .ui-btn { min-height: 48px; }

    .lc-pub__actlabel {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
    }
}

@container (min-width: 640px) {
    .lc-pub__actions {
        grid-template-columns: repeat(3, minmax(0, 150px));
    }

    .lc-pub__cover {
        aspect-ratio: 3 / 1;
        border-radius: var(--lc-r-xl);
    }

    .lc-pub__head,
    .lc-pub__section {
        padding: 0 var(--space-8);
    }

    .lc-pub__logo {
        width: 112px;
        height: 112px;
        font-size: 38px;
    }

    .lc-pub__head { margin-top: calc(var(--space-8) * -1 - 56px); }

    .lc-pub__svcside {
        flex-direction: row;
        align-items: center;
        gap: var(--space-4);
    }
}

@media (prefers-reduced-motion: reduce) {
    .lc-pub__service { animation: none; }
}

.lc-pubpage {
    min-height: 100dvh;
    background: var(--lc-canvas);
    color: var(--lc-ink-1);
}

.lc-pubpage__main {
    width: 100%;
    max-width: 880px;
    margin: 0 auto;
    padding: var(--space-4) 0 var(--space-12);
}

.lc-pubpage__bar {
    padding: 0 var(--space-3) var(--space-3);
}

.lc-pubpage__skeleton {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: 0 var(--space-5);
}

.lc-pubpage__main > .ui-empty {
    margin: 0 var(--space-5);
}

.lc-pub__service .ui-btn--secondary {
    background: var(--lc-info-tint);
    box-shadow: inset 0 0 0 1px rgba(45, 127, 240, 0.35);
    color: var(--azure-link);
}

.lc-pub__service .ui-btn--secondary:hover {
    background: rgba(45, 127, 240, 0.26);
}
