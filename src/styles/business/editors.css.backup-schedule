.biz-svc {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
}

.biz-svc__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
}

.biz-svc__item {
    border-radius: var(--lc-r-lg);
    background: var(--lc-raised);
    box-shadow: var(--lc-shadow-raised);
    animation: biz-svc-in var(--lc-base) var(--lc-ease);
}

.biz-svc__item.is-open {
    background: var(--lc-card);
    box-shadow: inset 0 0 0 1px var(--lc-line-strong);
}

.biz-svc__item.has-error {
    box-shadow: inset 0 0 0 1px rgba(240, 122, 110, 0.45);
}

@keyframes biz-svc-in {
    from { opacity: 0; transform: translateY(6px); }
}

.biz-svc__summary {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    padding-right: var(--space-2);
}

.biz-svc__open {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    grid-template-areas: 'name price chevron' 'meta price chevron';
    align-items: center;
    column-gap: var(--space-3);
    flex: 1;
    min-width: 0;
    min-height: 64px;
    padding: var(--space-3) var(--space-4);
    border: 0;
    border-radius: var(--lc-r-lg);
    background: none;
    color: var(--lc-ink-1);
    font-family: var(--lc-font-body);
    text-align: left;
    cursor: pointer;
    transition: transform var(--lc-fast) var(--lc-ease);
}

.biz-svc__open:active { transform: scale(0.99); }

.biz-svc__open:focus-visible {
    outline: 2px solid var(--azure);
    outline-offset: 2px;
}

.biz-svc__name {
    grid-area: name;
    overflow: hidden;
    font-size: var(--lc-t-body);
    font-weight: var(--font-weight-semibold);
    text-overflow: ellipsis;
    white-space: nowrap;
}

.biz-svc__meta {
    grid-area: meta;
    color: var(--lc-ink-3);
    font-size: var(--lc-t-label);
}

.biz-svc__price {
    grid-area: price;
    color: var(--lc-ink-1);
    font-family: var(--lc-font-mono);
    font-size: var(--lc-t-body);
    font-variant-numeric: tabular-nums;
}

.biz-svc__chevron {
    grid-area: chevron;
    color: var(--lc-ink-4);
}

.biz-svc__order {
    display: flex;
    gap: 2px;
    transition: opacity var(--lc-fast) var(--lc-ease);
}

@media (hover: hover) and (pointer: fine) {
    .biz-svc__order { opacity: 0; }

    .biz-svc__item:hover .biz-svc__order,
    .biz-svc__item:focus-within .biz-svc__order { opacity: 1; }
}

.biz-svc__order .ui-iconbtn:disabled {
    opacity: 0.3;
    cursor: default;
    pointer-events: none;
}

.biz-svc__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: var(--space-5);
}

.biz-svc__row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-3);
}

.biz-svc__row > .ui-field:first-child { flex: 1 1 280px; }
.biz-svc__row > .ui-field:nth-child(2) { flex: 0 1 120px; }

.biz-svc__formactions {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
}

.biz-svc__add {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
}

.biz-svc__suggest {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
}

.biz-svc__suggestlabel {
    color: var(--lc-ink-3);
    font-size: var(--lc-t-label);
}

.biz-svc__chipmeta {
    color: var(--lc-ink-3);
    font-family: var(--lc-font-mono);
    font-size: var(--lc-t-micro);
}


.biz-week {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
}

.biz-week__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
}

.biz-week__summary {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin: 0;
    font-size: var(--lc-t-body);
}

.biz-week__summary strong {
    color: var(--lc-ink-1);
    font-weight: var(--font-weight-semibold);
}

.biz-week__summary span {
    color: var(--lc-ink-3);
    font-family: var(--lc-font-mono);
    font-size: var(--lc-t-label);
    font-variant-numeric: tabular-nums;
}

.biz-week__days {
    margin: 0;
    padding: var(--space-2) 0;
    list-style: none;
    border-radius: var(--lc-r-lg);
    background: var(--lc-card);
    box-shadow: inset 0 0 0 1px var(--lc-line);
}

.biz-week__axis,
.biz-week__day {
    display: grid;
    grid-template-columns: 84px minmax(0, 1fr) 118px 48px;
    column-gap: var(--space-3);
    grid-template-areas: 'name track times switch' 'error error error error' 'editor editor editor editor';
    align-items: center;
    padding: 0 var(--space-4);
}

.biz-week__axis {
    grid-template-areas: 'name scale . .';
    height: 22px;
}

.biz-week__scale {
    grid-area: scale;
    position: relative;
    height: 100%;
}

.biz-week__scale span {
    position: absolute;
    top: 2px;
    color: var(--lc-ink-4);
    font-family: var(--lc-font-mono);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
    transform: translateX(-50%);
}

.biz-week__day {
    min-height: 52px;
    border-radius: var(--lc-r-md);
    transition: background var(--lc-fast) var(--lc-ease);
}

.biz-week__day.is-editing {
    margin: var(--space-1) var(--space-2);
    padding: 0 var(--space-2) var(--space-3);
    background: var(--lc-raised);
    box-shadow: var(--lc-shadow-raised);
}

.biz-week__name {
    grid-area: name;
    color: var(--lc-ink-1);
    font-size: var(--lc-t-label);
    font-weight: var(--font-weight-semibold);
}

.biz-week__day:not(.is-open) .biz-week__name {
    color: var(--lc-ink-3);
    font-weight: var(--font-weight-medium);
}

.biz-week__times {
    grid-area: times;
    justify-self: end;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: center;
    gap: 1px;
    max-width: 100%;
    min-height: 32px;
    padding: 2px var(--space-2);
    overflow: hidden;
    border: 0;
    border-radius: var(--lc-r-sm);
    background: none;
    color: var(--lc-ink-2);
    font-family: var(--lc-font-mono);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    text-align: right;
    text-overflow: ellipsis;
    white-space: nowrap;
    cursor: pointer;
    transition: background var(--lc-fast) var(--lc-ease), color var(--lc-fast) var(--lc-ease);
}

.biz-week__times:focus-visible {
    outline: 2px solid var(--azure);
    outline-offset: 2px;
}

@media (hover: hover) {
    button.biz-week__times:hover {
        background: var(--lc-raised-hover);
        color: var(--lc-ink-1);
    }
}

.biz-week__day > .ui-switch {
    grid-area: switch;
    justify-self: end;
}

.biz-week__error {
    grid-area: error;
    margin: 0 0 var(--space-2);
    color: var(--lc-danger);
    font-size: 12px;
    font-weight: var(--font-weight-medium);
}

.biz-week__editor {
    grid-area: editor;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-3);
    animation: biz-svc-in var(--lc-base) var(--lc-ease);
}

.biz-week__window {
    display: flex;
    align-items: center;
    gap: var(--space-2);
}

.biz-week__to {
    color: var(--lc-ink-3);
    font-size: var(--lc-t-label);
}

.biz-week__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1);
}

.biz-week__actions .ui-btn--secondary { margin-left: auto; }

.biz-week__hint {
    margin: 0;
    color: var(--lc-ink-3);
    font-size: 12px;
}

.biz-track {
    grid-area: track;
    position: relative;
    height: 30px;
    border-radius: var(--lc-r-sm);
    background: var(--lc-well);
    box-shadow: inset 0 0 0 1px var(--lc-line);
}

.biz-track__closed {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--lc-ink-4);
    font-size: 12px;
}

.biz-track__bar {
    position: absolute;
    top: 3px;
    bottom: 3px;
    min-width: 6px;
    border-radius: 6px;
    background: var(--azure);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2), 0 1px 3px rgba(3, 8, 24, 0.55);
}

.biz-week__day.has-error .biz-track__bar { background: var(--lc-danger); }

.biz-track__body {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    cursor: grab;
    touch-action: none;
}

.biz-track__body:active { cursor: grabbing; }

.biz-track__handle {
    position: absolute;
    top: 50%;
    z-index: 1;
    width: 16px;
    height: 32px;
    cursor: ew-resize;
    touch-action: none;
    transform: translateY(-50%);
}

.biz-track__handle--start { left: -8px; }
.biz-track__handle--end { right: -8px; }

.biz-track__handle::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 4px;
    height: 14px;
    border-radius: var(--radius-full);
    background: var(--lc-on-accent);
    box-shadow: 0 0 0 1px rgba(3, 8, 24, 0.35);
    opacity: 0;
    transform: translate(-50%, -50%);
    transition: opacity var(--lc-fast) var(--lc-ease), height var(--lc-fast) var(--lc-ease);
}

.biz-track__bar:hover .biz-track__handle::after,
.biz-track__handle:focus-visible::after,
.biz-track__handle:active::after { opacity: 1; }

.biz-track__handle:focus-visible {
    outline: none;
}

.biz-track__handle:focus-visible::after {
    height: 18px;
    box-shadow: 0 0 0 2px var(--azure), 0 0 0 5px var(--lc-info-tint);
}

@media (pointer: coarse) {
    .biz-track { height: 36px; }
    .biz-track__handle { width: 28px; height: 44px; }
    .biz-track__handle--start { left: -14px; }
    .biz-track__handle--end { right: -14px; }
    .biz-track__handle::after { opacity: 1; }
}

@container (max-width: 460px) {
    .biz-week__axis,
    .biz-week__day {
        grid-template-columns: minmax(0, 1fr) auto 48px;
        grid-template-areas: 'name times switch' 'track track track' 'error error error' 'editor editor editor';
        row-gap: 6px;
        padding: var(--space-2) var(--space-4);
    }

    .biz-week__axis {
        grid-template-areas: 'scale scale scale';
        padding-bottom: 0;
    }

    .biz-week__day:not(.is-open) .biz-track { display: none; }
}

@media (prefers-reduced-motion: reduce) {
    .biz-svc__item,
    .biz-week__editor {
        animation: none;
    }

    .biz-track__handle::after,
    .biz-week__times { transition: none; }

    .biz-svc__order { transition: none; }

    .biz-svc__open { transition: none; }
}

@media (max-width: 767px), (pointer: coarse) {
    .biz-svc .ui-btn--sm,
    .biz-week .ui-btn--sm,
    .biz-svc .ui-chip {
        min-height: 44px;
    }

    .biz-svc .ui-iconbtn--sm,
    .biz-week .ui-iconbtn--sm {
        width: 44px;
        height: 44px;
    }

    .biz-week__times { min-height: 44px; }

    .biz-week .ui-picker-trigger--sm {
        min-height: 44px;
    }
}

@container (max-width: 460px) {
    .biz-week__day:not(.is-open) { row-gap: 0; }
    .biz-week__day:not(.is-open) .biz-week__times { display: none; }
}
