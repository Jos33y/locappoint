.biz-svc {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
}

.biz-svc__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
}

.biz-svc__item {
    border-radius: var(--lc-r-lg);
    background: var(--lc-raised);
    box-shadow: var(--lc-shadow-raised);
    animation: biz-svc-in var(--lc-base) var(--lc-ease);
}

.biz-svc__item.is-open {
    background: var(--lc-card);
    box-shadow: inset 0 0 0 1px var(--lc-line-strong);
}

.biz-svc__item.has-error {
    box-shadow: inset 0 0 0 1px rgba(240, 122, 110, 0.45);
}

@keyframes biz-svc-in {
    from { opacity: 0; transform: translateY(6px); }
}

.biz-svc__summary {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    padding-right: var(--space-2);
}

.biz-svc__open {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    grid-template-areas: 'name price chevron' 'meta price chevron';
    align-items: center;
    column-gap: var(--space-3);
    flex: 1;
    min-width: 0;
    min-height: 64px;
    padding: var(--space-3) var(--space-4);
    border: 0;
    border-radius: var(--lc-r-lg);
    background: none;
    color: var(--lc-ink-1);
    font-family: var(--lc-font-body);
    text-align: left;
    cursor: pointer;
    transition: transform var(--lc-fast) var(--lc-ease);
}

.biz-svc__open:active { transform: scale(0.99); }

.biz-svc__open:focus-visible {
    outline: 2px solid var(--azure);
    outline-offset: 2px;
}

.biz-svc__name {
    grid-area: name;
    overflow: hidden;
    font-size: var(--lc-t-body);
    font-weight: var(--font-weight-semibold);
    text-overflow: ellipsis;
    white-space: nowrap;
}

.biz-svc__meta {
    grid-area: meta;
    color: var(--lc-ink-3);
    font-size: var(--lc-t-label);
}

.biz-svc__price {
    grid-area: price;
    color: var(--lc-ink-1);
    font-family: var(--lc-font-mono);
    font-size: var(--lc-t-body);
    font-variant-numeric: tabular-nums;
}

.biz-svc__chevron {
    grid-area: chevron;
    color: var(--lc-ink-4);
}

.biz-svc__order {
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.biz-svc__order .ui-iconbtn:disabled {
    opacity: 0.3;
    cursor: default;
    pointer-events: none;
}

.biz-svc__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: var(--space-5);
}

.biz-svc__row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-3);
}

.biz-svc__row > .ui-field:first-child { flex: 1 1 280px; }
.biz-svc__row > .ui-field:nth-child(2) { flex: 0 1 120px; }

.biz-svc__formactions {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
}

.biz-svc__add {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
}

.biz-svc__suggest {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
}

.biz-svc__suggestlabel {
    color: var(--lc-ink-3);
    font-size: var(--lc-t-label);
}

.biz-svc__chipmeta {
    color: var(--lc-ink-3);
    font-family: var(--lc-font-mono);
    font-size: var(--lc-t-micro);
}


.biz-hours {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
}

.biz-hours__bulk {
    display: flex;
    justify-content: flex-end;
}

.biz-hours__days {
    margin: 0;
    padding: 0;
    list-style: none;
    border-radius: var(--lc-r-lg);
    background: var(--lc-card);
    box-shadow: inset 0 0 0 1px var(--lc-line);
}

.biz-hours__day {
    padding: var(--space-2) var(--space-4);
}

.biz-hours__day + .biz-hours__day {
    border-top: 1px solid var(--lc-line);
}

.biz-hours__day .ui-switchrow__desc {
    font-family: var(--lc-font-mono);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
}

.biz-hours__day:not(.is-open) .ui-switchrow__label {
    color: var(--lc-ink-3);
}

.biz-hours__windows {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-1) 0 var(--space-3);
    animation: biz-svc-in var(--lc-base) var(--lc-ease);
}

.biz-hours__window {
    display: flex;
    align-items: center;
    gap: var(--space-2);
}

.biz-hours__to {
    color: var(--lc-ink-3);
    font-size: var(--lc-t-label);
}

.biz-hours__error {
    margin: 0;
    color: var(--lc-danger);
    font-size: 12px;
    font-weight: var(--font-weight-medium);
}

.biz-hours__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-left: calc(var(--space-4) * -1);
}

@media (prefers-reduced-motion: reduce) {
    .biz-svc__item,
    .biz-hours__windows {
        animation: none;
    }

    .biz-svc__open { transition: none; }
}

@media (max-width: 767px), (pointer: coarse) {
    .biz-svc .ui-btn--sm,
    .biz-hours .ui-btn--sm,
    .biz-svc .ui-chip {
        min-height: 44px;
    }

    .biz-svc .ui-iconbtn--sm,
    .biz-hours .ui-iconbtn--sm {
        width: 44px;
        height: 44px;
    }

    .biz-svc__order {
        flex-direction: row;
    }
}
