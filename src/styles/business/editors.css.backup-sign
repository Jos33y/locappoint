.biz-svc {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
}

.biz-svc__menu {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: var(--lc-r-xl);
    background: var(--lc-card);
    box-shadow: inset 0 0 0 1px var(--lc-line);
}

.biz-svc__cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 84px 84px 20px;
    column-gap: var(--space-3);
    padding: var(--space-3) var(--space-4) var(--space-2) 60px;
    color: var(--lc-ink-3);
    font-size: 12px;
    font-weight: var(--font-weight-medium);
}

.biz-svc__cols span:nth-child(2),
.biz-svc__cols span:nth-child(3) {
    text-align: right;
}

.biz-svc__list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
}

.biz-svc__item {
    position: relative;
    border-radius: var(--lc-r-xl);
    transition: transform var(--lc-base) var(--lc-ease);
}

.biz-svc__item + .biz-svc__item::before {
    content: '';
    position: absolute;
    top: 0;
    left: 60px;
    right: var(--space-4);
    height: 1px;
    background: var(--lc-line);
}

.biz-svc__menu.is-dragging .biz-svc__item.is-lifted {
    border-radius: var(--lc-r-md);
    background: var(--lc-raised);
    box-shadow: var(--lc-shadow-overlay);
    transition: none;
}

.biz-svc__menu.is-dragging .biz-svc__item::before,
.biz-svc__item.is-open::before,
.biz-svc__item.is-open + .biz-svc__item::before {
    display: none;
}

.biz-svc__item.is-open {
    margin: var(--space-2);
    border-radius: var(--lc-r-lg);
    background: var(--lc-raised);
    box-shadow: inset 0 0 0 1px var(--lc-line-strong);
    animation: biz-svc-in var(--lc-base) var(--lc-ease);
}

.biz-svc__item.has-error {
    box-shadow: inset 0 0 0 1px rgba(240, 122, 110, 0.45);
}

@keyframes biz-svc-in {
    from { opacity: 0; transform: translateY(4px); }
}

.biz-svc__summary {
    display: flex;
    align-items: stretch;
    padding-left: var(--space-2);
}

.biz-svc__handle {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    margin: var(--space-2) 0;
    padding: 0;
    border: 0;
    border-radius: var(--lc-r-sm);
    background: none;
    color: var(--lc-ink-4);
    cursor: grab;
    touch-action: none;
    transition: color var(--lc-fast) var(--lc-ease), background var(--lc-fast) var(--lc-ease);
}

.biz-svc__handle:hover {
    background: var(--lc-raised);
    color: var(--lc-ink-2);
}

.biz-svc__menu.is-dragging .biz-svc__handle {
    cursor: grabbing;
}

.biz-svc__handle:focus-visible,
.biz-svc__open:focus-visible,
.biz-svc__addrow:focus-visible {
    outline: 2px solid var(--azure);
    outline-offset: -2px;
}

.biz-svc__open {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 84px 84px 20px;
    align-items: center;
    column-gap: var(--space-3);
    flex: 1;
    min-width: 0;
    min-height: 60px;
    padding: var(--space-3) var(--space-4) var(--space-3) var(--space-2);
    border: 0;
    border-radius: var(--lc-r-md);
    background: none;
    color: var(--lc-ink-1);
    font-family: var(--lc-font-body);
    text-align: left;
    cursor: pointer;
    transition: background var(--lc-fast) var(--lc-ease);
}

.biz-svc__summary:not(:has(.biz-svc__handle)) .biz-svc__open {
    padding-left: var(--space-3);
}

.biz-svc__open:hover {
    background: var(--lc-raised);
}

.biz-svc__main {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: var(--space-2);
    row-gap: 2px;
    min-width: 0;
}

.biz-svc__name {
    overflow: hidden;
    max-width: 100%;
    font-size: var(--lc-t-body);
    font-weight: var(--font-weight-semibold);
    text-overflow: ellipsis;
    white-space: nowrap;
}

.biz-svc__desc {
    flex-basis: 100%;
    overflow: hidden;
    color: var(--lc-ink-3);
    font-size: var(--lc-t-label);
    text-overflow: ellipsis;
    white-space: nowrap;
}

.biz-svc__hidden {
    padding: 1px 8px;
    border-radius: var(--radius-full);
    background: var(--lc-well);
    box-shadow: inset 0 0 0 1px var(--lc-line);
    color: var(--lc-ink-3);
    font-size: 11px;
    font-weight: var(--font-weight-medium);
}

.biz-svc__time,
.biz-svc__price {
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
}

.biz-svc__time {
    color: var(--lc-ink-2);
    font-size: var(--lc-t-label);
}

.biz-svc__price {
    color: var(--lc-ink-1);
    font-size: var(--lc-t-body);
    font-weight: var(--font-weight-semibold);
}

.biz-svc__item.is-hidden .biz-svc__name,
.biz-svc__item.is-hidden .biz-svc__time,
.biz-svc__item.is-hidden .biz-svc__price {
    color: var(--lc-ink-3);
}

.biz-svc__chevron {
    color: var(--lc-ink-4);
}

.biz-svc__addrow {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 56px;
    margin: 0;
    padding: 0 var(--space-4) 0 var(--space-4);
    border: 0;
    border-top: 1px solid var(--lc-line);
    border-radius: 0 0 var(--lc-r-xl) var(--lc-r-xl);
    background: none;
    color: var(--lc-info);
    font-family: var(--lc-font-body);
    font-size: var(--lc-t-body);
    font-weight: var(--font-weight-medium);
    text-align: left;
    cursor: pointer;
    transition: background var(--lc-fast) var(--lc-ease);
}

.biz-svc__menu:not(:has(.biz-svc__list)) .biz-svc__addrow {
    border-top: 0;
    border-radius: var(--lc-r-xl);
}

.biz-svc__addrow:hover {
    background: var(--lc-raised);
}

.biz-svc__addicon {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    margin-left: 6px;
    border-radius: var(--radius-full);
    background: var(--lc-info-tint);
}

@media (max-width: 559px) {
    .biz-svc__cols { display: none; }

    .biz-svc__open {
        grid-template-columns: minmax(0, 1fr) auto 16px;
        grid-template-areas: 'main price chev' 'time price chev';
        row-gap: 2px;
    }

    .biz-svc__main { grid-area: main; }
    .biz-svc__time { grid-area: time; text-align: left; }
    .biz-svc__price { grid-area: price; }
    .biz-svc__chevron { grid-area: chev; }
    .biz-svc__handle { width: 40px; }
}

.biz-svc__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: var(--space-5);
}

.biz-svc__row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-3);
}

.biz-svc__row > .ui-field:first-child { flex: 1 1 280px; }
.biz-svc__row > .ui-field:nth-child(2) { flex: 0 1 120px; }

.biz-svc__formactions {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
}

.biz-svc__suggest {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
}

.biz-svc__suggestlabel {
    color: var(--lc-ink-3);
    font-size: var(--lc-t-label);
}

.biz-svc__chipmeta {
    color: var(--lc-ink-3);
    font-family: var(--lc-font-mono);
    font-size: var(--lc-t-micro);
}


.biz-sched {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
}

.biz-sched__templates {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2);
    width: 100%;
}

@media (max-width: 559px) {
    .biz-sched__templates {
        grid-template-columns: 1fr;
    }

    .biz-sched__templates .biz-sched__template {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        grid-template-areas: 'glyph title' 'glyph detail';
        align-items: center;
        column-gap: var(--space-4);
        row-gap: 2px;
    }

    .biz-sched__template .biz-glyph { grid-area: glyph; }
    .biz-sched__template .biz-sched__ttitle { grid-area: title; }
    .biz-sched__template .biz-sched__tdetail { grid-area: detail; }
}

.biz-sched__template {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    padding: var(--space-3) var(--space-4);
    border: 0;
    border-radius: var(--lc-r-lg);
    background: var(--lc-card);
    box-shadow: inset 0 0 0 1px var(--lc-line);
    color: var(--lc-ink-1);
    font-family: var(--lc-font-body);
    text-align: left;
    cursor: pointer;
    transition: box-shadow var(--lc-fast) var(--lc-ease), background var(--lc-fast) var(--lc-ease), transform var(--lc-fast) var(--lc-ease);
}

.biz-sched__template:active { transform: scale(0.98); }

.biz-sched__template.is-on {
    background: var(--lc-raised);
    box-shadow: inset 0 0 0 1.5px var(--azure), var(--lc-shadow-raised);
}

.biz-sched__template:focus-visible {
    outline: 2px solid var(--azure);
    outline-offset: 2px;
}

@media (hover: hover) {
    .biz-sched__template:not(.is-on):hover { background: var(--lc-raised); }
}

.biz-sched__ttitle {
    font-size: var(--lc-t-label);
    font-weight: var(--font-weight-semibold);
}

.biz-sched__tdetail {
    color: var(--lc-ink-3);
    font-size: 12px;
}

.biz-glyph {
    display: inline-flex;
    gap: 3px;
}

.biz-glyph span {
    position: relative;
    width: 12px;
    height: 16px;
    border-radius: 3px;
    box-shadow: inset 0 0 0 1px var(--lc-line-strong);
}

.biz-glyph span.is-open {
    background: var(--azure);
    box-shadow: none;
}

.biz-glyph span.has-lunch::after {
    content: '';
    position: absolute;
    top: 7px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--lc-canvas);
}

.biz-sched__cards {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
}

.biz-sched__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4);
    border-radius: var(--lc-r-lg);
    background: var(--lc-card);
    box-shadow: inset 0 0 0 1px var(--lc-line);
    animation: biz-svc-in var(--lc-base) var(--lc-ease);
}

.biz-sched__foot {
    display: flex;
    justify-content: flex-end;
    margin-top: calc(var(--space-1) * -1);
}

.biz-sched__card.has-error { box-shadow: inset 0 0 0 1px rgba(240, 122, 110, 0.45); }

.biz-sched__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
}

.biz-sched__days {
    display: grid;
    grid-template-columns: repeat(7, 36px);
    gap: 6px;
}

.biz-sched__day {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-full);
    background: none;
    box-shadow: inset 0 0 0 1px var(--lc-line-strong);
    color: var(--lc-ink-2);
    font-family: var(--lc-font-body);
    font-size: 13px;
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
    transition: background var(--lc-fast) var(--lc-ease), color var(--lc-fast) var(--lc-ease), transform var(--lc-fast) var(--lc-ease);
}

.biz-sched__day:active { transform: scale(0.94); }

.biz-sched__day.is-on {
    background: var(--lc-azure-button);
    box-shadow: none;
    color: var(--lc-on-accent);
}

.biz-sched__day.is-taken {
    background: var(--lc-well);
    box-shadow: none;
    color: var(--lc-ink-4);
    text-decoration: line-through;
    text-decoration-color: var(--lc-line-strong);
    text-decoration-thickness: 1.5px;
    cursor: not-allowed;
}

.biz-sched__day.is-taken:active { transform: none; }

.biz-sched__day:focus-visible {
    outline: 2px solid var(--azure);
    outline-offset: 2px;
}

.biz-sched__line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
}

.biz-sched__label {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    width: 104px;
    color: var(--lc-ink-3);
    font-size: var(--lc-t-label);
}

.biz-sched__to {
    color: var(--lc-ink-3);
    font-size: var(--lc-t-label);
}

.biz-sched__none {
    color: var(--lc-ink-3);
    font-size: var(--lc-t-label);
}


.biz-sched__hint {
    margin: 0;
    color: var(--lc-ink-3);
    font-size: 12px;
}

.biz-sched__error {
    margin: 0;
    color: var(--lc-danger);
    font-size: 12px;
    font-weight: var(--font-weight-medium);
}


.biz-wk {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    width: 100%;
    padding: var(--space-4) var(--space-5) var(--space-3);
    border-radius: var(--lc-r-lg);
    background: var(--lc-card);
    box-shadow: inset 0 0 0 1px var(--lc-line);
}

.biz-wk__axis,
.biz-wk__row {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) 112px;
    align-items: center;
    column-gap: var(--space-4);
}

.biz-wk__axis::before {
    content: '';
}

.biz-wk__scale {
    position: relative;
    height: 14px;
}

.biz-wk__scale span {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    color: var(--lc-ink-4);
    font-family: var(--lc-font-mono);
    font-size: var(--lc-t-micro);
    line-height: 14px;
}

.biz-wk__rows {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
}

.biz-wk__row {
    min-height: 32px;
}

.biz-wk__day {
    color: var(--lc-ink-3);
    font-size: var(--lc-t-label);
    font-weight: var(--font-weight-medium);
}

.biz-wk__row.is-today .biz-wk__day {
    color: var(--lc-info);
    font-weight: var(--font-weight-semibold);
}

.biz-wk__track {
    position: relative;
    height: 32px;
}

.biz-wk__grid {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--lc-line);
}

.biz-wk__bar {
    position: absolute;
    top: 50%;
    height: 12px;
    border-radius: var(--radius-full);
    background: var(--azure);
    transform: translateY(-50%);
    transition: left var(--lc-base) var(--lc-ease), width var(--lc-base) var(--lc-ease);
}

.biz-wk__row.is-closed .biz-wk__track::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    border-top: 1px dashed var(--lc-line-strong);
}

.biz-wk__now {
    position: absolute;
    top: 3px;
    bottom: 3px;
    width: 2px;
    margin-left: -1px;
    border-radius: var(--radius-full);
    background: var(--signal);
    box-shadow: 0 0 0 2px var(--lc-card);
}

.biz-wk__hours {
    color: var(--lc-ink-2);
    font-family: var(--lc-font-mono);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    text-align: right;
    white-space: nowrap;
}

.biz-wk__row.is-closed .biz-wk__hours {
    color: var(--lc-ink-4);
    font-family: var(--lc-font-body);
}

@media (max-width: 559px) {
    .biz-wk {
        padding: var(--space-3) var(--space-4);
    }

    .biz-wk__axis,
    .biz-wk__row {
        grid-template-columns: 30px minmax(0, 1fr) 90px;
        column-gap: var(--space-3);
    }

    .biz-wk__hours {
        font-size: var(--lc-t-micro);
    }

    .biz-sched__line {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
        row-gap: var(--space-2);
    }

    .biz-sched__label {
        grid-column: 1 / -1;
        width: auto;
    }

    .biz-sched__none {
        grid-column: 1 / -1;
    }

    .biz-sched__line .ui-picker-wrap,
    .biz-sched__line .ui-picker-trigger--compact {
        width: 100%;
    }
}

@media (prefers-reduced-motion: reduce) {
    .biz-wk__bar { transition: none; }

    .biz-svc__item,
    .biz-sched__card {
        animation: none;
    }

    .biz-sched__day,
    .biz-sched__template { transition: none; }

    .biz-svc__item,
    .biz-svc__open,
    .biz-svc__handle { transition: none; }
}

@media (max-width: 767px), (pointer: coarse) {
    .biz-svc .ui-btn--sm,
    .biz-sched .ui-btn--sm,
    .biz-svc .ui-chip {
        min-height: 44px;
    }

    .biz-sched .ui-iconbtn--sm {
        width: 44px;
        height: 44px;
    }

    .biz-sched__switch::before {
        content: '';
        position: absolute;
        inset: -8px;
    }

    .biz-sched__days {
        width: 100%;
        max-width: 332px;
        grid-template-columns: repeat(7, minmax(0, 1fr));
        gap: 4px;
    }

    .biz-sched__day {
        width: 100%;
        max-width: 44px;
        height: auto;
        aspect-ratio: 1;
        justify-self: center;
    }

    .biz-sched .ui-picker-trigger--sm {
        min-height: 44px;
    }
}


.biz-address {
    position: relative;
    display: block;
}

.biz-address__pop {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    right: 0;
    z-index: var(--z-dropdown, 50);
    display: flex;
    flex-direction: column;
    padding: var(--space-2);
    border-radius: var(--lc-r-lg);
    background: var(--lc-overlay);
    box-shadow: inset 0 0 0 1px var(--lc-line-strong), var(--lc-shadow-overlay);
}

.biz-address__list {
    display: flex;
    flex-direction: column;
}

.biz-address__option {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--lc-r-sm);
    color: var(--lc-ink-3);
    cursor: pointer;
}

.biz-address__option.is-active { background: var(--lc-info-tint); }

.biz-address__option > svg { flex: none; margin-top: 2px; }

.biz-address__one {
    display: block;
    color: var(--lc-ink-1);
    font-size: var(--lc-t-label);
    font-weight: var(--font-weight-medium);
}

.biz-address__two {
    display: block;
    color: var(--lc-ink-3);
    font-size: 12px;
}

.biz-address__credit {
    padding: var(--space-2) var(--space-3) var(--space-1);
    color: var(--lc-ink-4);
    font-size: 11px;
}

@media (max-width: 767px), (pointer: coarse) {
    .biz-address__option { min-height: 48px; align-items: center; }
}
