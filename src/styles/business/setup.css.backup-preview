.lc-setup {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    background: var(--lc-canvas);
    color: var(--lc-ink-1);
    font-family: var(--lc-font-body);
    -webkit-font-smoothing: antialiased;
}


.lc-setup__work {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 100vh;
    min-height: 100dvh;
}

.lc-setup__top {
    position: sticky;
    top: 0;
    z-index: 20;
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: 'brand spacer actions' 'stepper stepper stepper';
    align-items: center;
    gap: var(--space-3) var(--space-3);
    padding: calc(var(--space-3) + env(safe-area-inset-top, 0px)) var(--space-4) var(--space-3);
    border-bottom: 1px solid var(--lc-line);
    background: var(--lc-glass);
    backdrop-filter: var(--lc-glass-blur);
    -webkit-backdrop-filter: var(--lc-glass-blur);
}

.lc-setup:not(.lc-setup--steps) .lc-setup__top {
    position: static;
    grid-template-areas: 'brand spacer actions';
    border-bottom-color: transparent;
    background: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
}

.lc-setup__brand {
    grid-area: brand;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
}

.lc-setup .lc-mark {
    display: block;
    flex: none;
}

.lc-setup .lc-wordmark {
    font-family: var(--lc-font-display);
    font-size: 17px;
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-tight);
}

.lc-setup .lc-wordmark__accent { color: var(--azure); }

.lc-setup__stepper {
    grid-area: stepper;
    min-width: 0;
}

.lc-setup__topactions {
    grid-area: actions;
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
}

.lc-setup__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    flex: 1;
    width: 100%;
    max-width: 620px;
    margin: 0 auto;
    padding: var(--space-8) var(--space-5) 0;
}

.lc-setup__intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
}

.lc-setup__title {
    margin: 0;
    font-family: var(--lc-font-display);
    font-size: var(--lc-t-title);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--lc-track-title);
    line-height: var(--lc-lh-tight);
    outline: none;
}

.lc-setup__lede {
    max-width: 52ch;
    margin: 0;
    color: var(--lc-ink-2);
    font-size: var(--lc-t-body);
    line-height: var(--lc-lh-body);
}

.lc-setup__fields {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
}

.lc-setup__pair {
    display: grid;
    gap: var(--space-5);
}

.lc-setup__slugstatus {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    min-height: 20px;
    margin: calc(var(--space-3) * -1) 0 0;
    color: var(--lc-ink-3);
    font-size: 12px;
}

.lc-setup__slugstatus:empty { display: none; }

.lc-setup__media {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: var(--space-5);
}

.lc-setup__monogram {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background: var(--azure);
    color: var(--lc-on-accent);
    font-family: var(--lc-font-display);
    font-size: 36px;
    font-weight: var(--font-weight-semibold);
}

.lc-setup__error {
    margin: 0;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--lc-r-md);
    background: var(--lc-danger-tint);
    color: var(--lc-danger);
    font-size: var(--lc-t-label);
    font-weight: var(--font-weight-medium);
}

.lc-setup__foot {
    position: sticky;
    bottom: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin: auto calc(var(--space-5) * -1) 0;
    padding: var(--space-3) var(--space-5) calc(var(--space-3) + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid var(--lc-line);
    background: var(--lc-canvas);
}

.lc-setup__footright {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
}

.lc-setup__footstrength { display: inline-flex; }

.lc-setup__welcome,
.lc-setup__live {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    width: 100%;
    max-width: 620px;
    margin: 0 auto;
    padding: var(--space-10) var(--space-5) var(--space-12);
    animation: lc-setup-arrive var(--lc-base) var(--lc-ease) both;
}

@keyframes lc-setup-arrive {
    from { opacity: 0; transform: translateY(10px); }
}

.lc-setup__hero {
    margin: 0;
    font-family: var(--lc-font-display);
    font-size: clamp(2.25rem, 1.8rem + 2.2vw, 3.25rem);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--lc-track-display);
    line-height: var(--lc-lh-tight);
}

.lc-setup__lede--lg {
    display: flex;
    flex-direction: column;
    font-size: 1.125rem;
}

.lc-setup__promise {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
    border-radius: var(--lc-r-lg);
    background: var(--lc-card);
    box-shadow: inset 0 0 0 1px var(--lc-line);
}

.lc-setup__promise li {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
}

.lc-setup__promise li + li { border-top: 1px solid var(--lc-line); }

.lc-setup__promise li > span:last-child {
    display: flex;
    flex-direction: column;
    gap: 2px;
    color: var(--lc-ink-3);
    font-size: var(--lc-t-label);
}

.lc-setup__promise strong {
    color: var(--lc-ink-1);
    font-size: var(--lc-t-body);
    font-weight: var(--font-weight-semibold);
}

.lc-setup__promisenum {
    display: grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-full);
    background: var(--lc-info-tint);
    color: var(--azure-link);
    font-family: var(--lc-font-mono);
    font-size: var(--lc-t-label);
    font-weight: var(--font-weight-medium);
}

.lc-setup__then {
    margin: calc(var(--space-2) * -1) 0 0;
    padding-left: var(--space-5);
    color: var(--lc-ink-3);
    font-size: var(--lc-t-label);
}

.lc-setup__showcase {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    margin: 0 0 var(--space-12);
    padding: var(--space-8) var(--space-5) 0;
    border-top: 1px solid var(--lc-line);
}



.lc-setup__welcomeactions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
}

.lc-setup__fine {
    margin: 0;
    color: var(--lc-ink-3);
    font-size: var(--lc-t-label);
}

.lc-setup__livehead {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-6);
}

.lc-setup__livetext {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
}

.lc-setup__livepct {
    font-family: var(--lc-font-display);
    font-size: 44px;
    font-weight: var(--font-weight-semibold);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--lc-track-display);
    line-height: 1;
}

.lc-setup__livepct small {
    margin-left: 2px;
    color: var(--lc-ink-3);
    font-size: 20px;
}

.lc-setup__livecap {
    margin-top: var(--space-1);
    color: var(--lc-ink-3);
    font-size: var(--lc-t-micro);
}

.lc-setup__linkcard,
.lc-setup__qrcard {
    padding: var(--space-5);
    border-radius: var(--lc-r-lg);
    background: var(--lc-raised);
    box-shadow: var(--lc-shadow-raised);
}

.lc-setup__linkcard {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
}

.lc-setup__linklabel {
    color: var(--lc-ink-3);
    font-size: var(--lc-t-label);
}

.lc-setup__link {
    margin: 0;
    overflow-wrap: anywhere;
    font-family: var(--lc-font-mono);
    font-size: clamp(1.0625rem, 0.95rem + 0.6vw, 1.375rem);
}

.lc-setup__host { color: var(--lc-ink-3); }
.lc-setup__slug { color: var(--azure-link); }

.lc-setup__linkactions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-1);
}

.lc-setup__qrcard {
    display: flex;
    align-items: center;
    gap: var(--space-5);
}

.lc-setup__qrtext {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    min-width: 0;
    color: var(--lc-ink-3);
    font-size: var(--lc-t-label);
}

.lc-setup__qrtext strong {
    color: var(--lc-ink-1);
    font-family: var(--lc-font-display);
    font-size: var(--lc-t-heading);
    font-weight: var(--font-weight-semibold);
}

.lc-setup__nextstep {
    margin: 0;
    color: var(--lc-ink-3);
    font-size: var(--lc-t-label);
}

.lc-setup__live > .ui-btn { align-self: flex-start; }

.lc-setup__sheetpreview {
    margin: 0 calc(var(--space-5) * -1);
    overflow: hidden;
}

@media (min-width: 560px) {
    .lc-setup__pair { grid-template-columns: 1fr 1fr; }

    .lc-setup__livehead {
        flex-direction: row;
        align-items: center;
    }

    .lc-setup__form { padding-top: var(--space-10); }
}

@media (max-width: 420px) {
    .lc-setup__media { grid-template-columns: 1fr; }

    .lc-setup__qrcard {
        flex-direction: column;
        align-items: flex-start;
    }

    .lc-setup__foot .ui-btn--quiet .ui-btn__content { gap: 0; }
}

@media (min-width: 1024px) {
    .lc-setup:not(.lc-setup--solo) {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(440px, 44%);
    }

    .lc-setup__top {
        grid-template-columns: auto minmax(0, 1fr) auto;
        grid-template-areas: 'brand stepper actions';
        gap: var(--space-8);
        padding: var(--space-4) var(--space-8);
    }

    .lc-setup__stepper {
        width: 100%;
        max-width: 420px;
        justify-self: center;
    }

    .lc-setup__form { padding: var(--space-10) var(--space-8) 0; }

    .lc-setup__foot {
        margin: auto calc(var(--space-8) * -1) 0;
        padding: var(--space-4) var(--space-8);
    }

    .lc-setup__welcome,
    .lc-setup__live {
        flex: 1;
        justify-content: center;
        padding: var(--space-10) var(--space-8);
    }
}

.lc-setup__stage {
    --lc-phone-h: max(420px, min(760px, calc(100dvh - 150px)));
    position: sticky;
    top: 0;
    z-index: 1;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-5);
    height: 100vh;
    height: 100dvh;
    padding: var(--space-6);
    border-left: 1px solid var(--lc-line);
    background: var(--lc-panel);
}

.lc-setup__grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.7;
    pointer-events: none;
}

.lc-setup__grid svg {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
}

.lc-setup__stagehead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    width: max(300px, calc(var(--lc-phone-h) * 375 / 780));
    max-width: 100%;
    min-height: 30px;
    white-space: nowrap;
}

.lc-setup__stagelabel {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--lc-ink-2);
    font-size: var(--lc-t-label);
    font-weight: var(--font-weight-medium);
}

.lc-setup__pulse {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background: var(--lc-success);
    box-shadow: 0 0 0 3px var(--lc-success-tint);
}

.lc-setup__strength {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--lc-ink-3);
    font-size: var(--lc-t-label);
}

.lc-setup__num {
    color: var(--lc-ink-1);
    font-family: var(--lc-font-mono);
    font-weight: var(--font-weight-medium);
    font-variant-numeric: tabular-nums;
}

@media (prefers-reduced-motion: reduce) {
    .lc-setup__welcome,
    .lc-setup__live {
        animation: none;
    }
}

@media (max-width: 767px), (pointer: coarse) {
    .lc-setup .ui-btn--sm {
        min-height: 44px;
    }
}


.lc-demo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    margin: 0;
}

.lc-demo__tag {
    padding: 3px 12px;
    border-radius: var(--radius-full);
    background: var(--lc-card);
    box-shadow: inset 0 0 0 1px var(--lc-line-strong);
    color: var(--lc-ink-2);
    font-family: var(--lc-font-mono);
    font-size: var(--lc-t-micro);
    letter-spacing: 0.04em;
}

.lc-demo__stage {
    position: relative;
    padding: 0 var(--space-12) var(--space-6);
}

.lc-demo__page {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-bottom: var(--space-4);
    color: var(--lc-ink-1);
}

.lc-demo__cover {
    height: 92px;
    overflow: hidden;
    background: var(--lc-panel);
    box-shadow: inset 0 -1px 0 var(--lc-line);
}

.lc-demo__cover svg {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
}

.lc-demo__id {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    margin-top: -40px;
    padding: 0 var(--space-4);
}

.lc-demo__logo {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin-bottom: var(--space-2);
    border-radius: var(--lc-r-md);
    background: var(--azure);
    box-shadow: 0 0 0 3px var(--lc-canvas);
    color: var(--lc-on-accent);
    font-family: var(--lc-font-display);
    font-size: 19px;
    font-weight: var(--font-weight-semibold);
}

.lc-demo__name {
    font-family: var(--lc-font-display);
    font-size: 17px;
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--lc-track-title);
}

.lc-demo__meta,
.lc-demo__label,
.lc-demo__svcmeta {
    color: var(--lc-ink-3);
    font-size: 12px;
}

.lc-demo__block {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: 0 var(--space-4);
}

.lc-demo__slots {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
}

.lc-demo__slot {
    padding: 7px 0;
    border-radius: var(--lc-r-sm);
    background: var(--lc-card);
    box-shadow: inset 0 0 0 1px var(--lc-line-strong);
    color: var(--lc-ink-2);
    font-family: var(--lc-font-mono);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    text-align: center;
}

.lc-demo__slot.is-picked {
    background: var(--lc-azure-button);
    box-shadow: none;
    color: var(--lc-on-accent);
}

.lc-demo__services {
    display: flex;
    flex-direction: column;
    margin: 0 var(--space-4);
    padding: 0;
    list-style: none;
    border-radius: var(--lc-r-md);
    background: var(--lc-raised);
    box-shadow: var(--lc-shadow-raised);
}

.lc-demo__services li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 10px var(--space-3);
}

.lc-demo__services li + li { border-top: 1px solid var(--lc-line); }

.lc-demo__svc {
    display: flex;
    flex-direction: column;
    min-width: 0;
}

.lc-demo__svcname {
    overflow: hidden;
    font-size: 13px;
    font-weight: var(--font-weight-semibold);
    text-overflow: ellipsis;
    white-space: nowrap;
}

.lc-demo__price {
    flex: none;
    font-family: var(--lc-font-mono);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
}

.lc-demo__cta {
    display: grid;
    place-items: center;
    min-height: 42px;
    margin: 0 var(--space-4);
    border-radius: var(--radius-full);
    background: var(--lc-azure-button);
    color: var(--lc-on-accent);
    font-size: 14px;
    font-weight: var(--font-weight-semibold);
}

.lc-demo__ticket {
    position: absolute;
    top: 92px;
    right: -64px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    width: max-content;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--lc-r-md);
    background: var(--lc-overlay);
    box-shadow: inset 0 0 0 1px var(--lc-line-strong), var(--lc-shadow-overlay);
    font-size: 12px;
    animation: lc-demo-ticket 520ms var(--lc-ease) 400ms both;
}

.lc-demo__ticket strong {
    font-size: 14px;
    font-weight: var(--font-weight-semibold);
}

.lc-demo__ticket span:last-child {
    white-space: nowrap;
    color: var(--lc-ink-3);
    font-family: var(--lc-font-mono);
    font-variant-numeric: tabular-nums;
}

@keyframes lc-demo-ticket {
    from { opacity: 0; transform: translateY(10px); }
}

@media (max-width: 1279px) {
    .lc-demo__stage {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 0;
    }

    .lc-demo__ticket {
        position: relative;
        top: auto;
        right: auto;
        margin-top: -14px;
    }
}

@media (max-width: 480px) {

    .lc-setup__lede--lg { font-size: 1rem; }
}

@media (prefers-reduced-motion: reduce) {
    .lc-demo__ticket { animation: none; }
}

@media (min-width: 1024px) and (max-height: 760px) {
    .lc-setup__welcome,
    .lc-setup__live {
        gap: var(--space-5);
        padding-top: var(--space-6);
        padding-bottom: var(--space-6);
    }

    .lc-setup__hero { font-size: clamp(2.25rem, 1.6rem + 2vw, 2.75rem); }

    .lc-setup__promise li { padding: var(--space-3) var(--space-5); }

    .lc-demo { zoom: 0.88; }
}

@media (min-width: 1024px) and (max-height: 640px) {
    .lc-setup__welcome,
    .lc-setup__live {
        gap: var(--space-4);
        padding-top: var(--space-4);
        padding-bottom: var(--space-4);
    }

    .lc-setup__lede--lg { font-size: 1rem; }

    .lc-setup__promise li { padding: 10px var(--space-5); }

    .lc-demo { zoom: 0.76; }
}


:root:has(.lc-setup--steps) {
    scroll-padding-top: 96px;
    scroll-padding-bottom: 112px;
}

.lc-setup__stage .ui-phone:not(.ui-phone--fit) {
    height: var(--lc-phone-h);
    min-height: 0;
}

@media (min-width: 1024px) and (max-height: 760px) {
    .lc-setup__form {
        gap: var(--space-6);
        padding-top: var(--space-6);
    }

    .lc-setup__stage { gap: var(--space-3); }
}

@media (min-width: 660px) and (max-width: 1023px) {
    .lc-setup__top {
        padding-left: calc((100% - 620px) / 2 + var(--space-5));
        padding-right: calc((100% - 620px) / 2 + var(--space-5));
    }
}
