.biz-pay__intro {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin: calc(var(--space-2) * -1) 0 0;
    color: var(--lc-ink-2);
    font-size: var(--lc-t-body);
    line-height: var(--lc-lh-snug);
}

.biz-pay__test {
    color: var(--lc-warning);
}

/* Where the money goes: the bank is the loudest thing in the section. */
.biz-pay__bank {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4);
    border-radius: var(--lc-r-lg);
    background: var(--lc-well);
    box-shadow: inset 0 0 0 1px var(--lc-line);
}

.biz-pay__bankicon {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: var(--lc-r-md);
    background: var(--lc-card);
    box-shadow: inset 0 0 0 1px var(--lc-line);
    color: var(--lc-ink-1);
}

.biz-pay__banktext {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
}

.biz-pay__bankname {
    overflow: hidden;
    color: var(--lc-ink-1);
    font-family: var(--lc-font-display);
    font-size: 17px;
    font-weight: var(--font-weight-semibold);
    text-overflow: ellipsis;
    white-space: nowrap;
}

.biz-pay__banknum {
    color: var(--lc-ink-2);
    font-size: var(--lc-t-label);
    font-variant-numeric: tabular-nums;
}

.biz-pay__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
}

.biz-pay__nuban {
    font-family: var(--lc-font-mono);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.06em;
}

.biz-pay__confirm:empty {
    display: none;
}

.biz-pay__checking {
    color: var(--lc-ink-3);
    font-size: var(--lc-t-label);
}

.biz-pay__name {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--lc-r-md);
    background: var(--lc-success-tint);
    color: var(--lc-success);
}

.biz-pay__name > svg {
    flex: none;
}

.biz-pay__name span {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
}

.biz-pay__namelabel {
    color: var(--lc-ink-2);
    font-size: var(--lc-t-label);
}

.biz-pay__name b {
    color: var(--lc-ink-1);
    font-size: var(--lc-t-body);
    font-weight: var(--font-weight-semibold);
    overflow-wrap: anywhere;
}

.biz-pay__notice {
    margin: 0;
    color: var(--lc-ink-2);
    font-size: var(--lc-t-label);
}

.biz-pay__private {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    margin: 0;
    color: var(--lc-ink-3);
    font-size: var(--lc-t-label);
    line-height: var(--lc-lh-snug);
}

.biz-pay__private > svg {
    flex: none;
    margin-top: 2px;
}
