.lc-pub {
    --lc-pub-gutter: var(--space-4);
    --lc-pub-logo: 80px;
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    width: 100%;
    color: var(--lc-ink-1);
    font-family: var(--lc-font-body);
}

.lc-pub__cover {
    position: relative;
    aspect-ratio: 12 / 5;
    overflow: hidden;
    background: var(--lc-panel);
}

.lc-pub__cover img,
.lc-pub__cover svg,
.lc-pub__cover .ui-skel {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
}

.lc-pub__cover::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px var(--lc-line);
    pointer-events: none;
}

.lc-pub__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: 0 var(--lc-pub-gutter);
}

.lc-pub__main,
.lc-pub__aside {
    display: contents;
}

.lc-pub__head { order: 1; }
.lc-pub__status { order: 2; }
.lc-pub__actions { order: 3; }
.lc-pub__about { order: 4; }
.lc-pub__menu { order: 5; }
.lc-pub__hours { order: 6; }
.lc-pub__find { order: 7; }

.lc-pub__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    min-width: 0;
}

.lc-pub__logo {
    position: relative;
    z-index: 1;
    display: grid;
    flex: none;
    place-items: center;
    width: var(--lc-pub-logo);
    height: var(--lc-pub-logo);
    overflow: hidden;
    margin-top: calc(var(--lc-pub-logo) / -2);
    border-radius: var(--lc-r-xl);
    background: var(--azure);
    box-shadow: 0 0 0 4px var(--lc-canvas), var(--lc-shadow-raised);
    color: var(--lc-on-accent);
    font-family: var(--lc-font-display);
    font-size: calc(var(--lc-pub-logo) * 0.34);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.01em;
}

.lc-pub__logo img {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
}

.lc-pub__logo.is-skeleton { background: var(--lc-raised); }

.lc-pub__id {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
    width: 100%;
}

.lc-pub__name {
    margin: 0;
    font-family: var(--lc-font-display);
    font-size: clamp(1.75rem, 8cqi, 2.625rem);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--lc-track-title);
    line-height: var(--lc-lh-tight);
    overflow-wrap: anywhere;
}

.lc-pub__where {
    margin: 0;
    color: var(--lc-ink-2);
    font-size: var(--lc-t-body);
}

.lc-pub__about {
    max-width: 62ch;
    margin: 0;
    color: var(--lc-ink-2);
    font-size: var(--lc-t-body);
    line-height: var(--lc-lh-body);
    white-space: pre-line;
    overflow-wrap: anywhere;
}

.lc-pub__actions {
    display: grid;
    grid-auto-columns: minmax(0, 1fr);
    grid-auto-flow: column;
    gap: var(--space-2);
}

.lc-pub__actions .ui-btn {
    min-width: 0;
    min-height: 60px;
    padding: var(--space-2) var(--space-1);
    border-radius: var(--lc-r-lg);
    font-size: var(--lc-t-label);
}

.lc-pub__actions .ui-btn__content {
    flex-direction: column;
    gap: 5px;
}

.lc-pub__actions svg { flex: none; }

.lc-pub__card {
    border-radius: var(--lc-r-xl);
    background: var(--lc-card);
    box-shadow: inset 0 0 0 1px var(--lc-line);
}

.lc-pub__h2 {
    margin: 0;
    color: var(--lc-ink-1);
    font-family: var(--lc-font-display);
    font-size: var(--lc-t-heading);
    font-weight: var(--font-weight-semibold);
    letter-spacing: -0.01em;
}


.lc-pub__status {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5) var(--space-5);
}

.lc-pub__statusrow {
    display: flex;
    align-items: center;
    gap: var(--space-4);
}

.lc-pub__statustext {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
}

.lc-pub__state,
.lc-pub__when,
.lc-pub__note {
    margin: 0;
}

.lc-pub__state {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: var(--space-2);
    color: var(--lc-ink-2);
    font-size: var(--lc-t-label);
    font-weight: var(--font-weight-semibold);
}

.lc-pub__status.is-open .lc-pub__state { color: var(--lc-success); }
.lc-pub__status.is-lunch .lc-pub__state { color: var(--lc-warning); }

.lc-pub__zone {
    color: var(--lc-ink-3);
    font-size: 12px;
    font-weight: var(--font-weight-medium);
}

.lc-pub__when {
    color: var(--lc-ink-2);
    font-size: var(--lc-t-body);
    line-height: var(--lc-lh-snug);
}

.lc-pub__when b {
    color: var(--lc-ink-1);
    font-family: var(--lc-font-display);
    font-size: 1.875rem;
    font-weight: var(--font-weight-semibold);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    line-height: 1;
    white-space: nowrap;
}

.lc-pub__note {
    color: var(--lc-ink-2);
    font-size: var(--lc-t-label);
    font-variant-numeric: tabular-nums;
    line-height: var(--lc-lh-snug);
}

.lc-pub__strip {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.lc-pub__striptrack {
    position: relative;
    height: 20px;
}

.lc-pub__stripwin {
    position: absolute;
    top: 6px;
    display: flex;
    height: 8px;
    overflow: hidden;
    border-radius: var(--radius-full);
}

.lc-pub__stripwin i {
    display: block;
    height: 100%;
    background: var(--azure);
}

.lc-pub__stripwin i.is-past { background: var(--lc-line-strong); }

.lc-pub__stripgap {
    position: absolute;
    top: 3px;
    display: grid;
    place-items: center;
    width: 14px;
    height: 14px;
    margin-left: -7px;
    color: var(--signal);
}

.lc-pub__stripnow {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    margin-left: -1px;
    border-radius: var(--radius-full);
    background: var(--signal);
    box-shadow: 0 0 0 2px var(--lc-card);
}

.lc-pub__stripscale {
    display: flex;
    justify-content: space-between;
    color: var(--lc-ink-3);
    font-family: var(--lc-font-mono);
    font-size: var(--lc-t-micro);
    font-variant-numeric: tabular-nums;
}


.lc-pub__menu {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
}

.lc-pub__sechead {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    column-gap: var(--space-4);
    row-gap: 2px;
}

.lc-pub__sechead p {
    margin: 0;
    color: var(--lc-ink-3);
    font-size: var(--lc-t-label);
}

.lc-pub__list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: var(--space-1);
    list-style: none;
}

.lc-pub__list > li {
    position: relative;
}

.lc-pub__list > li + li::before {
    content: '';
    position: absolute;
    top: 0;
    left: calc(var(--space-3) + 36px + var(--space-3));
    right: var(--space-3);
    height: 1px;
    background: var(--lc-line);
}

.lc-pub__svc {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr) auto 20px;
    align-items: center;
    column-gap: var(--space-3);
    width: 100%;
    min-height: 68px;
    margin: 0;
    padding: var(--space-3);
    border: 0;
    border-radius: var(--lc-r-lg);
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: background var(--lc-fast) var(--lc-ease), transform var(--lc-fast) var(--lc-ease);
    -webkit-tap-highlight-color: transparent;
}

.lc-pub__svc:active { transform: scale(0.985); background: var(--lc-raised); }

.lc-pub__svc:focus-visible {
    outline: 2px solid var(--azure);
    outline-offset: -2px;
}

@media (hover: hover) {
    .lc-pub__svc:hover { background: var(--lc-raised); }
    .lc-pub__svc:hover .lc-pub__go { background: var(--lc-azure-button); color: var(--lc-on-accent); }
}

.lc-pub__list > li:has(.lc-pub__svc:hover)::before,
.lc-pub__list > li:has(.lc-pub__svc:hover) + li::before {
    opacity: 0;
}

.lc-pub__dial { width: 36px; height: 36px; }

.lc-pub__svcmain {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
}

.lc-pub__svcname {
    color: var(--lc-ink-1);
    font-size: 1rem;
    font-weight: var(--font-weight-semibold);
    line-height: var(--lc-lh-snug);
    overflow-wrap: anywhere;
}

.lc-pub__svctime {
    color: var(--lc-ink-2);
    font-size: var(--lc-t-label);
    font-variant-numeric: tabular-nums;
}

.lc-pub__svcdesc {
    display: -webkit-box;
    overflow: hidden;
    margin-top: 2px;
    color: var(--lc-ink-3);
    font-size: var(--lc-t-label);
    line-height: var(--lc-lh-snug);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
}

.lc-pub__price {
    color: var(--lc-ink-1);
    font-family: var(--lc-font-display);
    font-size: 1.375rem;
    font-weight: var(--font-weight-semibold);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.015em;
    white-space: nowrap;
}

.lc-pub__go {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: var(--radius-full);
    color: var(--lc-info);
    transition: background var(--lc-fast) var(--lc-ease), color var(--lc-fast) var(--lc-ease);
}

.lc-pub__skelrow {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr) auto;
    align-items: center;
    column-gap: var(--space-3);
    min-height: 68px;
    padding: var(--space-3);
}

.lc-pub__ghost {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-4);
}

.lc-pub__ghostrows {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
}

.lc-pub__ghostrow {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 52px;
    padding: 0 var(--space-3);
    border-radius: var(--lc-r-lg);
    box-shadow: inset 0 0 0 1px var(--lc-line-strong);
}

.lc-pub__ghostrow i {
    display: block;
    height: 8px;
    border-radius: var(--radius-full);
    background: var(--lc-line-strong);
}

.lc-pub__ghostrow i.is-dial {
    flex: none;
    width: 24px;
    height: 24px;
    background: none;
    box-shadow: inset 0 0 0 1.5px var(--lc-line-strong);
}

.lc-pub__ghostrow i.is-price {
    width: 32px;
    height: 12px;
    margin-left: auto;
    background: var(--lc-info-tint);
}

.lc-pub__ghosttext {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
}

.lc-pub__ghosttext p {
    margin: 0;
    color: var(--lc-ink-2);
    font-size: var(--lc-t-label);
    line-height: var(--lc-lh-snug);
}

.lc-pub__ghosttext b {
    color: var(--lc-ink-1);
    font-weight: var(--font-weight-semibold);
}


.lc-pub__hours {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5) var(--space-5) var(--space-3);
}

.lc-pub__days {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
}

.lc-pub__day {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 44px;
    padding: var(--space-2) 0;
}

.lc-pub__day + .lc-pub__day::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--lc-line);
}

.lc-pub__day.is-today {
    margin: 0 calc(var(--space-3) * -1);
    padding-left: var(--space-3);
    padding-right: var(--space-3);
    border-radius: var(--lc-r-md);
    background: var(--lc-raised);
}

.lc-pub__day.is-today::before,
.lc-pub__day.is-today + .lc-pub__day::before {
    display: none;
}

.lc-pub__dayname {
    display: flex;
    flex-direction: column;
    gap: 1px;
    color: var(--lc-ink-1);
    font-size: var(--lc-t-body);
    font-weight: var(--font-weight-medium);
}

.lc-pub__day.is-closed:not(.is-today) .lc-pub__dayname { color: var(--lc-ink-3); }

.lc-pub__todaylabel {
    color: var(--lc-info);
    font-size: 12px;
    font-weight: var(--font-weight-semibold);
}

.lc-pub__daytimes {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 3px;
    min-width: 0;
    text-align: right;
}

.lc-pub__range { white-space: nowrap; }

.lc-pub__range b {
    color: var(--lc-ink-1);
    font-family: var(--lc-font-display);
    font-size: 1.0625rem;
    font-weight: var(--font-weight-semibold);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
}

.lc-pub__to {
    color: var(--lc-ink-3);
    font-size: var(--lc-t-label);
}

.lc-pub__closed,
.lc-pub__lunch {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
}

.lc-pub__closed {
    color: var(--lc-ink-3);
    font-size: var(--lc-t-body);
}

.lc-pub__lunch {
    color: var(--lc-ink-2);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
}

.lc-pub__lunch svg { color: var(--signal); }


.lc-pub__find {
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

.lc-pub__map {
    display: block;
    height: 88px;
    background: var(--lc-well);
}

.lc-pub__map svg {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
}

.lc-pub__findtext {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-5) var(--space-5);
}

.lc-pub__addr,
.lc-pub__area {
    margin: 0;
    overflow-wrap: anywhere;
}

.lc-pub__addr {
    margin-top: var(--space-1);
    color: var(--lc-ink-1);
    font-size: var(--lc-t-body);
    font-weight: var(--font-weight-medium);
    line-height: var(--lc-lh-snug);
}

.lc-pub__area {
    color: var(--lc-ink-3);
    font-size: var(--lc-t-label);
}


.lc-pub__foot {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-10) var(--lc-pub-gutter) 0;
    color: var(--lc-ink-3);
    font-size: var(--lc-t-label);
}

.lc-pub .lc-mark {
    display: block;
    flex: none;
}

.lc-pub .lc-wordmark {
    color: var(--lc-ink-2);
    font-family: var(--lc-font-display);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-tight);
}

.lc-pub .lc-wordmark__accent { color: var(--azure); }


.lc-pub__lost { max-width: none; }
.lc-pub__lostframe { fill: var(--lc-well); stroke: var(--lc-line-strong); stroke-width: 1.5; }
.lc-pub__loststreet { fill: none; stroke: var(--lc-line-strong); stroke-width: 1.5; }
.lc-pub__lostpin { fill: none; stroke: var(--lc-ink-3); stroke-width: 1.75; stroke-dasharray: 4 4; stroke-linejoin: round; }
.lc-pub__lostdot { fill: var(--signal); }


@container (max-width: 359px) {
    .lc-pub {
        --lc-pub-logo: 64px;
    }

    .lc-pub__body { gap: var(--space-4); }
    .lc-pub__status { padding: var(--space-4); }
    .lc-pub__hours { padding: var(--space-4) var(--space-4) var(--space-2); }
    .lc-pub__findtext { padding: var(--space-3) var(--space-4) var(--space-4); }
    .lc-pub__when b { font-size: 1.625rem; }

    .lc-pub__svc {
        grid-template-columns: 30px minmax(0, 1fr) auto;
        column-gap: var(--space-3);
        padding: var(--space-3) var(--space-2);
    }

    .lc-pub__dial { width: 30px; height: 30px; }
    .lc-pub__go { display: none; }
    .lc-pub__price { font-size: 1.1875rem; }
    .lc-pub__list > li + li::before { left: calc(var(--space-2) + 30px + var(--space-3)); }

    .lc-pub__actions .ui-btn {
        min-height: 56px;
        font-size: 12px;
    }

    .lc-pub__range b { font-size: 1rem; }
    .lc-pub__dayname { font-size: var(--lc-t-label); }
}

@container (max-width: 250px) {
    .lc-pub__actions .ui-btn { min-height: 48px; }
    .lc-pub__actions .ui-btn__content { gap: 0; font-size: 0; }
    .lc-pub__when b { font-size: 1.375rem; }
    .lc-pub__statusrow .biz-clock { width: 44px; height: 44px; }
}

@container (min-width: 600px) {
    .lc-pub {
        --lc-pub-gutter: var(--space-8);
        --lc-pub-logo: 104px;
    }

    .lc-pub__cover {
        aspect-ratio: auto;
        height: clamp(150px, 30vh, 280px);
        border-radius: var(--lc-r-xl);
    }

    .lc-pub__head {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        align-items: start;
        column-gap: var(--space-5);
    }

    .lc-pub__id { padding-top: var(--space-3); }

    .lc-pub__actions {
        grid-auto-columns: max-content;
        justify-content: start;
    }

    .lc-pub__actions .ui-btn {
        min-height: 48px;
        padding: 0 var(--space-4);
        border-radius: var(--radius-full);
    }

    .lc-pub__actions .ui-btn__content {
        flex-direction: row;
        gap: var(--space-2);
    }

    .lc-pub__svc { padding: var(--space-3) var(--space-4); }
    .lc-pub__list > li + li::before { left: calc(var(--space-4) + 36px + var(--space-3)); right: var(--space-4); }
    .lc-pub__price { font-size: 1.5rem; }
    .lc-pub__when b { font-size: 2.125rem; }
}

@container (min-width: 800px) {
    .lc-pub__body {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 340px;
        grid-template-areas:
            'head actions'
            'main aside';
        align-items: start;
        column-gap: var(--space-8);
        row-gap: var(--space-6);
    }

    .lc-pub__head { grid-area: head; }

    .lc-pub__actions {
        grid-area: actions;
        align-self: end;
        justify-content: end;
        padding-bottom: var(--space-1);
    }

    .lc-pub__main,
    .lc-pub__aside {
        display: flex;
        flex-direction: column;
        gap: var(--space-5);
        min-width: 0;
    }

    .lc-pub__main { grid-area: main; gap: var(--space-6); }

    .lc-pub__aside {
        position: sticky;
        top: calc(64px + var(--space-4));
        grid-area: aside;
        gap: var(--space-4);
    }
}

@container (min-width: 1000px) {
    .lc-pub__days {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        grid-template-rows: repeat(4, auto);
        grid-auto-flow: column;
        column-gap: var(--space-10);
    }

    .lc-pub__day:nth-child(5)::before { display: none; }
}

@media (prefers-reduced-motion: reduce) {
    .lc-pub__svc,
    .lc-pub__go {
        transition: none;
    }

    .lc-pub__svc:active { transform: none; }
}


.lc-pubpage {
    min-height: 100dvh;
    background: var(--lc-canvas);
    color: var(--lc-ink-1);
}

.lc-pubpage__main {
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
    padding: var(--space-2) 0 var(--space-16);
}

.lc-pubpage__bar {
    padding: 0 var(--space-2) var(--space-2);
}

.lc-pubpage__main > .ui-empty {
    margin: var(--space-6) var(--space-4) 0;
}

@media (min-width: 600px) {
    .lc-pubpage__main { padding-left: var(--space-6); padding-right: var(--space-6); }
    .lc-pubpage__bar { padding-left: 0; padding-right: 0; }
    .lc-pubpage__main > .ui-empty { margin-left: 0; margin-right: 0; }
    .lc-pubpage .lc-pub__cover { border-radius: var(--lc-r-xl); }
}

.lc-pub--preview {
    padding-bottom: var(--space-6);
}

