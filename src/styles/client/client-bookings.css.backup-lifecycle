.lc-cl-bookings {
    max-width: 720px;
}

.lc-cl-bookings__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-4);
}

.lc-cl-bookings__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
}

.lc-cl-bookings__none {
    margin: 0;
    padding: var(--space-6) var(--space-4);
    border-radius: var(--lc-r-lg);
    background: var(--lc-card);
    box-shadow: inset 0 0 0 1px var(--lc-line);
    color: var(--lc-ink-3);
    font-size: var(--lc-t-label);
    text-align: center;
}

.lc-cl-bookings__error {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-4);
    border-radius: var(--lc-r-lg);
    background: var(--lc-card);
    box-shadow: inset 0 0 0 1px var(--lc-line);
}

.lc-cl-bookings__error p {
    margin: 0;
    color: var(--lc-ink-2);
    font-size: var(--lc-t-label);
}


.lc-cl-bk {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
}

.lc-cl-bk__when {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px var(--space-3);
    margin: 0;
}

.lc-cl-bk__when b {
    color: var(--lc-ink-1);
    font-family: var(--lc-font-display);
    font-size: var(--lc-t-heading);
    font-weight: var(--font-weight-semibold);
}

.lc-cl-bk.is-lead .lc-cl-bk__when b { font-size: 1.375rem; }

.lc-cl-bk__when span {
    color: var(--lc-ink-3);
    font-size: var(--lc-t-label);
}

.lc-cl-bk .lc-bk-ticket { --lc-bk-notch: 10px; }
.lc-cl-bk .lc-bk-ticket__stub::before,
.lc-cl-bk .lc-bk-ticket__stub::after { background: var(--lc-canvas); }

.lc-cl-bk__note {
    margin: 0;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--lc-r-md);
    background: var(--lc-card);
    color: var(--lc-ink-2);
    font-size: var(--lc-t-label);
    line-height: var(--lc-lh-snug);
    overflow-wrap: anywhere;
}

.lc-cl-bk__note b { color: var(--lc-ink-1); font-weight: var(--font-weight-semibold); }

.lc-cl-bk__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
}

.lc-cl-bk__cancel { margin-left: auto; }

@media (hover: hover) {
    .lc-cl-bk__cancel.ui-btn--quiet:hover { color: var(--lc-danger); background: var(--lc-danger-tint); }
}


.lc-cl-pastlist {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: var(--space-1);
    list-style: none;
    border-radius: var(--lc-r-xl);
    background: var(--lc-card);
    box-shadow: inset 0 0 0 1px var(--lc-line);
}

.lc-cl-past {
    position: relative;
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) auto auto;
    align-items: center;
    column-gap: var(--space-3);
    min-height: 68px;
    padding: var(--space-3);
}

.lc-cl-past + .lc-cl-past::before {
    content: '';
    position: absolute;
    top: 0;
    left: calc(var(--space-3) + 44px + var(--space-3));
    right: var(--space-3);
    height: 1px;
    background: var(--lc-line);
}

.lc-cl-past__date {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 48px;
    border-radius: var(--lc-r-md);
    background: var(--lc-well);
    box-shadow: inset 0 0 0 1px var(--lc-line);
}

.lc-cl-past__date small {
    color: var(--lc-ink-3);
    font-size: 11px;
    font-weight: var(--font-weight-semibold);
}

.lc-cl-past__date b {
    font-family: var(--lc-font-display);
    font-size: 1.125rem;
    font-weight: var(--font-weight-semibold);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
}

.lc-cl-past__text {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
}

.lc-cl-past__text strong {
    color: var(--lc-ink-1);
    font-size: var(--lc-t-body);
    font-weight: var(--font-weight-semibold);
    overflow-wrap: anywhere;
}

.lc-cl-past__text span {
    color: var(--lc-ink-3);
    font-size: var(--lc-t-label);
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
}

.lc-cl-past__state {
    color: var(--lc-ink-3);
    font-size: 12px;
    font-weight: var(--font-weight-medium);
    white-space: nowrap;
}

.lc-cl-past__state.is-no_show { color: var(--lc-danger); }
.lc-cl-past__state.is-completed { color: var(--lc-success); }

.lc-cl-past__again {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 var(--space-3);
    border-radius: var(--radius-full);
    color: var(--lc-info);
    font-size: var(--lc-t-label);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    white-space: nowrap;
}

@media (hover: hover) {
    .lc-cl-past__again:hover { background: var(--lc-info-tint); color: var(--lc-info); }
}

.lc-cl-past__again:focus-visible {
    outline: 2px solid var(--azure);
    outline-offset: 2px;
}


.lc-cl-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
    padding: var(--space-10) var(--space-5);
    border-radius: var(--lc-r-xl);
    background: var(--lc-card);
    box-shadow: inset 0 0 0 1px var(--lc-line);
    text-align: center;
}

.lc-cl-empty__art { max-width: 100%; height: auto; }
.lc-cl-empty__ticket { fill: var(--lc-well); stroke: var(--lc-line-strong); stroke-width: 1.5; stroke-dasharray: 5 5; }
.lc-cl-empty__perf { stroke: var(--lc-line-strong); stroke-width: 1.5; stroke-dasharray: 3 4; }
.lc-cl-empty__rule { stroke: var(--lc-line); stroke-width: 1.5; }
.lc-cl-empty__line { fill: var(--lc-line-strong); }
.lc-cl-empty__line.is-strong { fill: var(--lc-ink-4); opacity: 0.5; }
.lc-cl-empty__dot { fill: var(--signal); }

.lc-cl-empty__text h2 {
    margin: 0 0 var(--space-1);
    font-family: var(--lc-font-display);
    font-size: 1.25rem;
    font-weight: var(--font-weight-semibold);
}

.lc-cl-empty__text p {
    max-width: 36ch;
    margin: 0;
    color: var(--lc-ink-2);
    font-size: var(--lc-t-body);
    line-height: var(--lc-lh-body);
}


.lc-cl-cancel {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
}

.lc-cl-cancel p { margin: 0; }

.lc-cl-cancel__what {
    color: var(--lc-ink-2);
    font-size: var(--lc-t-body);
}

.lc-cl-cancel__what b { color: var(--lc-ink-1); font-weight: var(--font-weight-semibold); }

.lc-cl-cancel__when {
    color: var(--lc-ink-1);
    font-family: var(--lc-font-display);
    font-size: 1.375rem;
    font-weight: var(--font-weight-semibold);
    font-variant-numeric: tabular-nums;
}

.lc-cl-cancel__fine {
    margin-top: var(--space-2);
    color: var(--lc-ink-3);
    font-size: var(--lc-t-label);
}

.lc-cl-cancel__error {
    padding: var(--space-3) var(--space-4);
    border-radius: var(--lc-r-md);
    background: var(--lc-danger-tint);
    color: var(--lc-ink-1);
    font-size: var(--lc-t-label);
}

.lc-cl-cancel__foot {
    display: flex;
    gap: var(--space-2);
}

.lc-cl-cancel__foot .ui-btn { flex: 1; }


.lc-cl-toast {
    position: fixed;
    left: 50%;
    bottom: calc(96px + env(safe-area-inset-bottom, 0px));
    z-index: var(--z-floating);
    transform: translateX(-50%);
    white-space: nowrap;
    pointer-events: none;
}

@media (min-width: 1024px) {
    .lc-cl-toast { bottom: var(--space-8); left: calc(50% + 136px); }
}

@media (hover: none) {
    .lc-cl-bookings .ui-seg__btn { min-height: 44px; }
}

@media (max-width: 479px) {
    .lc-cl-bookings__head .ui-seg { width: 100%; }
    .lc-cl-bookings__head .ui-seg__btn { flex: 1; min-width: 0; padding: 0 var(--space-2); }

    .lc-cl-bk__actions .ui-btn { flex: 1; }
    .lc-cl-bk__cancel { margin-left: 0; flex-basis: 100%; }

    .lc-cl-past {
        grid-template-columns: 44px minmax(0, 1fr) auto;
        row-gap: 2px;
    }

    .lc-cl-past__state { grid-column: 2; grid-row: 2; justify-self: start; }
    .lc-cl-past__again { grid-column: 3; grid-row: 1 / span 2; padding: 0 var(--space-2); }
    .lc-cl-past__again span { display: none; }
}
