.lc-cl-frame {
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
}

.lc-cl-tabbar {
    grid-template-columns: repeat(4, 1fr);
}

.lc-cl-me {
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
}

.lc-cl-me .biz-avatar {
    width: 34px;
    height: 34px;
}

.lc-cl-search:hover { color: var(--lc-ink-3); }

.lc-cl-next {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    align-items: center;
    gap: var(--space-3);
    min-height: 64px;
    padding: var(--space-3);
    border-radius: var(--lc-r-lg);
    background: var(--lc-raised);
    box-shadow: var(--lc-shadow-raised);
    color: var(--lc-ink-1);
    text-decoration: none;
    transition: background var(--lc-fast) var(--lc-ease);
}

a.lc-cl-next:hover {
    background: var(--lc-raised-hover);
    color: var(--lc-ink-1);
}

.lc-cl-next:focus-visible {
    outline: 2px solid var(--azure);
    outline-offset: 2px;
}

.lc-cl-next__date {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 48px;
    border-radius: var(--lc-r-md);
    background: var(--lc-well);
    box-shadow: inset 0 0 0 1px var(--lc-line);
}

.lc-cl-next__date small {
    color: var(--lc-info);
    font-size: 11px;
    font-weight: var(--font-weight-semibold);
    line-height: 1.2;
}

.lc-cl-next__date b {
    font-family: var(--lc-font-display);
    font-size: 1.25rem;
    font-weight: var(--font-weight-semibold);
    font-variant-numeric: tabular-nums;
    line-height: 1.05;
}

.lc-cl-next__ico {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    background: var(--lc-info-tint);
    color: var(--lc-info);
}

.lc-cl-next__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
}

.lc-cl-next__text small {
    color: var(--lc-ink-3);
    font-size: 12px;
}

.lc-cl-next__text strong {
    overflow: hidden;
    color: var(--lc-ink-1);
    font-size: var(--lc-t-label);
    font-weight: var(--font-weight-semibold);
    font-variant-numeric: tabular-nums;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.lc-cl-next__text .lc-cl-next__time {
    font-family: var(--lc-font-display);
    font-size: 1.125rem;
    line-height: 1.2;
}

.lc-cl-next__text span {
    overflow: hidden;
    color: var(--lc-ink-2);
    font-size: 12px;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.lc-cl-next.is-empty {
    background: none;
    box-shadow: inset 0 0 0 1px var(--lc-line-strong);
}

.lc-cl-next.is-empty strong { color: var(--lc-info); }

.lc-cl-next.is-loading {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 8px;
}

.lc-cl-next.is-loading .lc-skel { height: 10px; width: 60%; }
.lc-cl-next.is-loading .lc-skel + .lc-skel { width: 85%; }

.lc-cl-who {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-1) var(--space-1) var(--space-2);
}

.lc-cl-who span:last-child {
    display: flex;
    flex-direction: column;
    min-width: 0;
}

.lc-cl-who strong {
    font-size: var(--lc-t-body);
    font-weight: var(--font-weight-semibold);
    overflow-wrap: anywhere;
}

.lc-cl-who small {
    color: var(--lc-ink-3);
    font-size: 12px;
    overflow-wrap: anywhere;
}

.lc-cl-shell .biz-more .lc-cl-next { margin-bottom: var(--space-2); }

@media (min-width: 1024px) {
    .lc-cl-shell .lc-cl-topacts { display: none; }

    .lc-cl-shell .biz-search {
        width: 320px;
        text-decoration: none;
    }

    .lc-cl-shell .biz-sidebar .lc-cl-next { margin: 0; }
}

@media (max-width: 1023px) {
    .lc-cl-shell .biz-topbar__actions { margin-left: auto; }
}
