.lc-bk-service {
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr) auto;
    align-items: center;
    column-gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--lc-r-lg);
    background: var(--lc-card);
    box-shadow: inset 0 0 0 1px var(--lc-line);
}

.lc-bk-service .biz-dial__face { fill: var(--lc-card); }

.lc-bk-service__text {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
}

.lc-bk-service__name {
    color: var(--lc-ink-1);
    font-size: var(--lc-t-body);
    font-weight: var(--font-weight-semibold);
    overflow-wrap: anywhere;
}

.lc-bk-service__meta {
    color: var(--lc-ink-2);
    font-size: var(--lc-t-label);
    overflow-wrap: anywhere;
}

.lc-bk-service__price {
    color: var(--lc-ink-1);
    font-family: var(--lc-font-display);
    font-size: 1.375rem;
    font-weight: var(--font-weight-semibold);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.015em;
    white-space: nowrap;
}


.lc-bk-days {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
}

.lc-bk-days__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin: calc(var(--space-2) * -1) 0 calc(var(--space-1) * -1);
}

.lc-bk-days__nav { display: flex; gap: var(--space-1); }

.lc-bk-days__arrow {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: var(--radius-full);
    background: none;
    color: var(--lc-ink-2);
    cursor: pointer;
    transition: background var(--lc-fast) var(--lc-ease), color var(--lc-fast) var(--lc-ease);
}

.lc-bk-days__arrow:disabled { color: var(--lc-ink-4); opacity: 0.5; cursor: default; }

.lc-bk-days__arrow:focus-visible {
    outline: 2px solid var(--azure);
    outline-offset: -2px;
}

@media (hover: hover) {
    .lc-bk-days__arrow:not(:disabled):hover { background: var(--lc-raised); color: var(--lc-ink-1); }
}

@media (hover: none) {
    .lc-bk-days__nav { display: none; }
    .lc-bk-days__head { margin: 0; }
}

.lc-bk-days__month {
    margin: 0;
    color: var(--lc-ink-2);
    font-size: var(--lc-t-label);
    font-weight: var(--font-weight-semibold);
}

.lc-bk-days__row {
    display: flex;
    gap: var(--space-2);
    margin: 0 calc(var(--space-5) * -1);
    padding: 2px var(--space-5) var(--space-2);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-padding: 0 var(--space-5);
    scrollbar-width: none;
}

.lc-bk-days__row::-webkit-scrollbar { display: none; }

.lc-bk-day {
    display: flex;
    flex: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    width: 60px;
    min-height: 76px;
    margin: 0;
    padding: var(--space-2) 0;
    border: 0;
    border-radius: var(--lc-r-lg);
    background: var(--lc-raised);
    box-shadow: var(--lc-shadow-raised);
    color: var(--lc-ink-1);
    font: inherit;
    cursor: pointer;
    transition: background var(--lc-fast) var(--lc-ease), transform var(--lc-fast) var(--lc-ease);
    -webkit-tap-highlight-color: transparent;
}

.lc-bk-day__wd {
    color: var(--lc-ink-2);
    font-size: 12px;
    font-weight: var(--font-weight-medium);
}

.lc-bk-day.is-today .lc-bk-day__wd { color: var(--lc-info); font-weight: var(--font-weight-semibold); }

.lc-bk-day__num {
    font-family: var(--lc-font-display);
    font-size: 1.375rem;
    font-weight: var(--font-weight-semibold);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
}

.lc-bk-day__sub {
    color: var(--lc-ink-3);
    font-size: 11px;
}

.lc-bk-day:disabled {
    background: none;
    box-shadow: inset 0 0 0 1px var(--lc-line);
    color: var(--lc-ink-4);
    cursor: default;
}

.lc-bk-day:disabled .lc-bk-day__wd,
.lc-bk-day:disabled .lc-bk-day__sub { color: var(--lc-ink-4); }

.lc-bk-day:disabled .lc-bk-day__num { text-decoration: line-through; text-decoration-thickness: 1px; }

.lc-bk-day[aria-pressed='true'] {
    background: var(--lc-azure-button);
    box-shadow: var(--lc-shadow-accent), inset 0 1px 0 rgba(255, 255, 255, 0.18);
    color: var(--lc-on-accent);
}

.lc-bk-day[aria-pressed='true'] .lc-bk-day__wd,
.lc-bk-day[aria-pressed='true'] .lc-bk-day__sub { color: var(--lc-on-accent); }

.lc-bk-day:active:not(:disabled) { transform: scale(0.96); }

.lc-bk-day:focus-visible,
.lc-bk-slot:focus-visible,
.lc-bk-back:focus-visible {
    outline: 2px solid var(--azure);
    outline-offset: 2px;
}

@media (hover: hover) {
    .lc-bk-day:not(:disabled):not([aria-pressed='true']):hover { background: var(--lc-raised-hover); }
}


.lc-bk-times {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
}

.lc-bk-window {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
}

.lc-bk-lunch {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    color: var(--lc-ink-2);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
}

.lc-bk-lunch svg { flex: none; color: var(--signal); }

.lc-bk-lunch::before,
.lc-bk-lunch::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--lc-line);
}

.lc-bk-lunch::before { flex: 0 0 var(--space-3); }

.lc-bk-slots {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(78px, 1fr));
    gap: var(--space-2);
}

.lc-bk-slot {
    min-height: 48px;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: var(--lc-r-md);
    background: var(--lc-raised);
    box-shadow: var(--lc-shadow-raised);
    color: var(--lc-ink-1);
    font-family: var(--lc-font-display);
    font-size: 1.0625rem;
    font-weight: var(--font-weight-semibold);
    font-variant-numeric: tabular-nums;
    cursor: pointer;
    transition: background var(--lc-fast) var(--lc-ease), transform var(--lc-fast) var(--lc-ease);
    -webkit-tap-highlight-color: transparent;
}

.lc-bk-slot[aria-pressed='true'] {
    background: var(--lc-azure-button);
    box-shadow: var(--lc-shadow-accent), inset 0 1px 0 rgba(255, 255, 255, 0.18);
    color: var(--lc-on-accent);
}

.lc-bk-slot:active { transform: scale(0.96); }

.lc-bk-slot.is-ghost {
    display: block;
    background: var(--lc-raised);
    box-shadow: none;
    animation: lc-pulse 1.4s var(--lc-ease) infinite;
}

@media (hover: hover) {
    .lc-bk-slot:not([aria-pressed='true']):hover { background: var(--lc-raised-hover); }
}

.lc-bk-window__full {
    margin: 0;
    color: var(--lc-ink-3);
    font-size: var(--lc-t-label);
}

.lc-bk-note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    padding: var(--space-4);
    border-radius: var(--lc-r-lg);
    background: var(--lc-card);
    box-shadow: inset 0 0 0 1px var(--lc-line);
}

.lc-bk-note > svg { flex: none; color: var(--lc-ink-3); }

.lc-bk-note > div {
    flex: 1;
    min-width: 160px;
}

.lc-bk-note__title,
.lc-bk-note__body { margin: 0; }

.lc-bk-note__title {
    color: var(--lc-ink-1);
    font-size: var(--lc-t-body);
    font-weight: var(--font-weight-semibold);
}

.lc-bk-note__body {
    color: var(--lc-ink-2);
    font-size: var(--lc-t-label);
}

.lc-bk-notice {
    margin: 0;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--lc-r-md);
    background: var(--lc-warning-tint);
    color: var(--lc-warning);
    font-size: var(--lc-t-label);
    font-weight: var(--font-weight-medium);
}


.lc-bk-back {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    margin: calc(var(--space-3) * -1) 0 calc(var(--space-3) * -1) calc(var(--space-2) * -1);
    padding: 0 var(--space-2);
    border: 0;
    border-radius: var(--radius-full);
    background: none;
    color: var(--lc-ink-2);
    font: inherit;
    font-size: var(--lc-t-label);
    font-weight: var(--font-weight-medium);
    cursor: pointer;
}

@media (hover: hover) {
    .lc-bk-back:hover { color: var(--lc-ink-1); background: var(--lc-raised); }
}


.lc-bk-ticket {
    --lc-bk-notch: 10px;
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: var(--lc-r-lg);
    background: var(--lc-card);
    box-shadow: inset 0 0 0 1px var(--lc-line-strong);
}

.lc-bk-ticket__main {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    column-gap: var(--space-5);
    padding: var(--space-5);
}

.lc-bk-ticket__date {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 72px;
    margin: 0;
    padding-right: var(--space-5);
    border-right: 1px solid var(--lc-line);
}

.lc-bk-ticket__wd,
.lc-bk-ticket__mon {
    color: var(--lc-ink-2);
    font-size: 12px;
    font-weight: var(--font-weight-medium);
}

.lc-bk-ticket__wd { color: var(--lc-info); font-weight: var(--font-weight-semibold); }

.lc-bk-ticket__day {
    color: var(--lc-ink-1);
    font-family: var(--lc-font-display);
    font-size: 2.5rem;
    font-weight: var(--font-weight-semibold);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.03em;
    line-height: 1.05;
}

.lc-bk-ticket__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
}

.lc-bk-ticket__time,
.lc-bk-ticket__svc,
.lc-bk-ticket__meta { margin: 0; }

.lc-bk-ticket__time {
    color: var(--lc-ink-2);
    font-size: var(--lc-t-body);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
}

.lc-bk-ticket__time b {
    color: var(--lc-ink-1);
    font-family: var(--lc-font-display);
    font-size: 2rem;
    font-weight: var(--font-weight-semibold);
    letter-spacing: -0.02em;
    line-height: 1.05;
}

.lc-bk-ticket__svc {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--lc-ink-1);
    font-size: var(--lc-t-body);
    font-weight: var(--font-weight-semibold);
}

.lc-bk-ticket__svc span { min-width: 0; overflow-wrap: anywhere; }

.lc-bk-ticket__meta {
    color: var(--lc-ink-2);
    font-size: var(--lc-t-label);
    font-variant-numeric: tabular-nums;
}

.lc-bk-ticket__stub {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-4) var(--space-5);
    border-top: 1.5px dashed var(--lc-line-strong);
}

.lc-bk-ticket__stub::before,
.lc-bk-ticket__stub::after {
    content: '';
    position: absolute;
    top: calc(var(--lc-bk-notch) * -1);
    width: calc(var(--lc-bk-notch) * 2);
    height: calc(var(--lc-bk-notch) * 2);
    border-radius: 50%;
    background: var(--lc-overlay);
    box-shadow: inset 0 0 0 1px var(--lc-line-strong);
    clip-path: inset(0 0 0 50%);
}

.lc-bk-ticket__stub::before { left: calc(var(--lc-bk-notch) * -1); }
.lc-bk-ticket__stub::after { right: calc(var(--lc-bk-notch) * -1); clip-path: inset(0 50% 0 0); }

.lc-bk-ticket__biz {
    color: var(--lc-ink-1);
    font-size: var(--lc-t-label);
    font-weight: var(--font-weight-semibold);
    overflow-wrap: anywhere;
}

.lc-bk-ticket__addr {
    color: var(--lc-ink-3);
    font-size: 12px;
    overflow-wrap: anywhere;
}

.lc-bk-ticket__stamp {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    padding: 3px 10px;
    border-radius: var(--lc-r-sm);
    box-shadow: inset 0 0 0 1.5px var(--signal);
    color: var(--signal);
    font-size: 12px;
    font-weight: var(--font-weight-semibold);
    transform: rotate(-6deg);
    animation: lc-bk-stamp var(--lc-base) var(--lc-ease) both;
}

@keyframes lc-bk-stamp {
    from { opacity: 0; transform: rotate(-6deg) scale(1.4); }
}


.lc-bk-gate {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    column-gap: var(--space-3);
    padding: var(--space-4);
    border-radius: var(--lc-r-lg);
    background: var(--lc-card);
    box-shadow: inset 0 0 0 1px var(--lc-line);
}

.lc-bk-gate__icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
    background: var(--lc-info-tint);
    color: var(--lc-info);
}

.lc-bk-gate p { margin: 0; }

.lc-bk-gate__title {
    color: var(--lc-ink-1);
    font-family: var(--lc-font-display);
    font-size: var(--lc-t-heading);
    font-weight: var(--font-weight-semibold);
}

.lc-bk-gate__body {
    margin-top: var(--space-1);
    color: var(--lc-ink-2);
    font-size: var(--lc-t-label);
    line-height: var(--lc-lh-body);
}

.lc-bk-gate .lc-bk-gate__fine {
    margin-top: var(--space-2);
    color: var(--lc-ink-3);
    font-size: 12px;
}


.lc-bk-details {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
}

.lc-bk-details__email {
    margin: 0;
    color: var(--lc-ink-3);
    font-size: var(--lc-t-label);
    overflow-wrap: anywhere;
}

.lc-bk-details__email b { color: var(--lc-ink-2); font-weight: var(--font-weight-medium); }

.lc-bk-done {
    margin: 0;
    color: var(--lc-ink-2);
    font-size: var(--lc-t-body);
    line-height: var(--lc-lh-body);
}


.lc-bk-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
}

.lc-bk-foot__sum {
    display: flex;
    flex-direction: column;
    min-width: 0;
    margin: 0;
}

.lc-bk-foot__day {
    color: var(--lc-ink-2);
    font-size: 12px;
}

.lc-bk-foot__sum b {
    color: var(--lc-ink-1);
    font-family: var(--lc-font-display);
    font-size: 1.1875rem;
    font-weight: var(--font-weight-semibold);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
}

.lc-bk-foot__hint {
    color: var(--lc-ink-3);
    font-size: var(--lc-t-label);
}

.lc-bk-foot .ui-btn { flex: none; min-width: 132px; }

.lc-bk-foot--gate .ui-btn { flex: 1; min-width: 0; }

@media (max-width: 359px) {
    .lc-bk-ticket__main { column-gap: var(--space-4); padding: var(--space-4); }
    .lc-bk-ticket__date { min-width: 56px; padding-right: var(--space-4); }
    .lc-bk-ticket__day { font-size: 2rem; }
    .lc-bk-ticket__time b { font-size: 1.625rem; }
    .lc-bk-ticket__stub { padding: var(--space-3) var(--space-4); }
    .lc-bk-service__price { font-size: 1.1875rem; }
    .lc-bk-foot .ui-btn { min-width: 112px; }
}

@media (prefers-reduced-motion: reduce) {
    .lc-bk-day,
    .lc-bk-slot { transition: none; }

    .lc-bk-day:active:not(:disabled),
    .lc-bk-slot:active { transform: none; }

    .lc-bk-slot.is-ghost,
    .lc-bk-ticket__stamp { animation: none; }
}
