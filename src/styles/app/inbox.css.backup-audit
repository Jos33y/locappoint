/* Notifications: the bell in both shells and the list page. Prefix lc-ibx. */

.lc-ibx-bell {
    position: relative;
}

.lc-ibx-bell__count {
    position: absolute;
    top: -4px;
    right: -6px;
    display: grid;
    place-items: center;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    border-radius: var(--radius-full);
    background: var(--lc-azure-button);
    box-shadow: 0 0 0 2px var(--lc-canvas);
    color: var(--lc-on-accent);
    font-size: 11px;
    font-weight: var(--font-weight-bold);
    line-height: 1;
}

.biz-page.lc-ibx {
    max-width: 720px;
}

.lc-ibx__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
}

.lc-ibx__head p {
    margin: 0;
    color: var(--lc-ink-3);
    font-size: var(--lc-t-body);
}

.lc-ibx__day {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
}

.lc-ibx__daylabel {
    margin: 0;
    padding: 0 var(--space-1);
    color: var(--lc-ink-3);
    font-size: var(--lc-t-label);
    font-weight: var(--font-weight-semibold);
}

.lc-ibx__list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: var(--space-1);
    list-style: none;
    border-radius: var(--lc-r-xl);
    background: var(--lc-card);
    box-shadow: inset 0 0 0 1px var(--lc-line);
}

.lc-ibx__list > li {
    position: relative;
}

.lc-ibx__list > li + li::before {
    content: '';
    position: absolute;
    top: 0;
    left: calc(var(--space-3) + 64px + var(--space-3));
    right: var(--space-5);
    height: 1px;
    background: var(--lc-line);
}

.lc-ibx__item {
    position: relative;
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    column-gap: var(--space-3);
    padding: var(--space-3);
    border-radius: var(--lc-r-md);
    color: inherit;
    text-decoration: none;
    transition: background var(--lc-fast) var(--lc-ease);
}

a.lc-ibx__item:focus-visible {
    outline: 2px solid var(--lc-info);
    outline-offset: -2px;
}

@media (hover: hover) {
    a.lc-ibx__item:hover { background: var(--lc-raised); }
}

.lc-ibx__item.is-fresh {
    background: var(--lc-info-tint);
}

.lc-ibx__when {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-top: 2px;
}

.lc-ibx__when b {
    color: var(--lc-ink-1);
    font-size: 1.25rem;
    font-weight: var(--font-weight-semibold);
    line-height: 1.1;
}

.lc-ibx__when small {
    color: var(--lc-ink-3);
    font-size: var(--lc-t-micro);
    font-weight: var(--font-weight-semibold);
}

.lc-ibx__body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
}

.lc-ibx__top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
}

.lc-ibx__label {
    min-width: 0;
    font-size: var(--lc-t-label);
    font-weight: var(--font-weight-semibold);
    overflow-wrap: anywhere;
}

.lc-ibx__item.is-success .lc-ibx__label { color: var(--lc-success); }
.lc-ibx__item.is-warning .lc-ibx__label { color: var(--lc-warning); }
.lc-ibx__item.is-danger .lc-ibx__label { color: var(--lc-danger); }
.lc-ibx__item.is-info .lc-ibx__label { color: var(--lc-info); }

.lc-ibx__ago {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: var(--space-2);
    color: var(--lc-ink-3);
    font-size: var(--lc-t-micro);
    white-space: nowrap;
}

.lc-ibx__dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background: var(--lc-info);
}

.lc-ibx__title {
    color: var(--lc-ink-1);
    font-size: var(--lc-t-body);
    font-weight: var(--font-weight-semibold);
    overflow-wrap: anywhere;
}

.lc-ibx__sub,
.lc-ibx__was {
    color: var(--lc-ink-3);
    font-size: var(--lc-t-label);
    overflow-wrap: anywhere;
}

.lc-ibx__was s {
    color: var(--lc-ink-2);
    font-variant-numeric: tabular-nums;
}

.lc-ibx__item.is-off .lc-ibx__when b {
    color: var(--lc-ink-3);
    text-decoration: line-through;
}

.lc-ibx__item.is-off .lc-ibx__title {
    color: var(--lc-ink-2);
}

.lc-ibx__skel {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    column-gap: var(--space-3);
    padding: var(--space-3);
}

.lc-ibx__error {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-4);
    border-radius: var(--lc-r-lg);
    background: var(--lc-card);
    box-shadow: inset 0 0 0 1px var(--lc-line);
}

.lc-ibx__error p {
    margin: 0;
    color: var(--lc-ink-2);
    font-size: var(--lc-t-label);
}

.lc-ibx-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
    padding: var(--space-10) var(--space-4);
    border-radius: var(--lc-r-xl);
    background: var(--lc-card);
    box-shadow: inset 0 0 0 1px var(--lc-line);
    text-align: center;
}

.lc-ibx-empty__art {
    max-width: 100%;
    height: auto;
}

.lc-ibx-empty__panel {
    fill: var(--lc-well);
    stroke: var(--lc-line-strong);
}

.lc-ibx-empty__ink {
    fill: var(--lc-raised-hover);
}

.lc-ibx-empty__ink.is-faint {
    fill: var(--lc-raised);
}

.lc-ibx-empty__now {
    fill: var(--lc-data-2);
}

.lc-ibx-empty__nowline {
    stroke: var(--lc-data-2);
    stroke-width: 2;
}

.lc-ibx-empty__slot {
    fill: none;
    stroke: var(--lc-line-strong);
    stroke-dasharray: 5 5;
}

.lc-ibx-empty__text h2 {
    margin: 0 0 var(--space-1);
    color: var(--lc-ink-1);
    font-size: var(--lc-t-heading);
    font-weight: var(--font-weight-semibold);
}

.lc-ibx-empty__text p {
    max-width: 36ch;
    margin: 0;
    color: var(--lc-ink-3);
    font-size: var(--lc-t-body);
}

@media (max-width: 380px) {
    .lc-ibx__item,
    .lc-ibx__skel {
        grid-template-columns: 52px minmax(0, 1fr);
        column-gap: var(--space-2);
    }

    .lc-ibx__when b {
        font-size: 1.0625rem;
    }

    .lc-ibx__list > li + li::before {
        left: calc(var(--space-3) + 52px + var(--space-2));
    }
}
